  pickTime: false
});

$('.time').datetimepicker({
  pickDate: false
});

$('.datetime').datetimepicker({
  pickDate: true,
  pickTime: true
});
//--></script>

<script type="text/javascript">
  var dateToday = new Date();
  $('.tmddate').datetimepicker({
    pickDate: true,
    pickTime: false,
    minDate: dateToday
  });
</script>

<script>
var rows = 0;
$('input[name=\'product\']').autocomplete({
  'source': function(request, response) {
    $.ajax({
      url: 'index.php?route=extension/bundleproduct/autocomplete&user_token={{ user_token }}&filter_name=' +  encodeURIComponent(request),
      dataType: 'json',
      success: function(json) {
        response($.map(json, function(item) {
          return {
            label: item['name'],
            value: item['product_id'],
            price: item['price']
          }
        }));
      }
    });
  },
  'select': function(item) {
    html  = '';
    html += ' <input type="hidden" name="bundle_product[' + item['value'] + '][name]" value="' + item['label'] + '" />';
    html += ' <input type="hidden" name="bundle_product[' + item['value'] + '][product_id]" value="' + item['value'] + '" />';

    html += ' <div class="form-group rmvfield'+rows+'"">';
    html += '   <label class="col-sm-3 control-label" for="input-required' + item['value'] + '">'+item['label']+'</label>';
    html += '   <div class="col-sm-6"><div class="input-group">';
    html += '<div class="row">';
    html += '<label class="col-sm-3 control-label" >Količina</label>';
    html +='<input style="max-width:200px" type="text" name="bundle_product[' + item['value'] + '][quantity]" placeholder="Količina" id="input-required' + item['value'] + '" class="form-control col-sm-9">';
    html += '</div>';
    html += '<div class="row">';
    html += '<label class="col-sm-3 control-label" >Poredak</label>';
    html +='<input style="max-width:200px" type="text" name="bundle_product[' + item['value'] + '][sort_order]" placeholder="Poredak" id="input-required' + item['value'] + '" class="form-control col-sm-9">';
    html += '</div>';
    html += '<div class="row">';
    html += '<label class="col-sm-3 control-label" >Pokaži na artiklu</label>';
       html +='<select style="max-width:200px" name="bundle_product[' + item['value'] + '][id_default]" id="input-required' + item['value'] + '" class="form-control col-sm-9">';
           {% if bundle_product.id_default %}
                                  html +=' <option value="1" selected="selected">{{ text_enabled }}</option>';
                                  html +=' <option value="0">{{ text_disabled }}</option>';
                                  {% else %}
                                  html +=' <option value="1">{{ text_enabled }}</option>';
                                  html +=' <option value="0" selected="selected">{{ text_disabled }}</option>';
                                {% endif %}
                           html +=' </select>';
                      html +=' </div>';
    html += ' <span class="input-group-btn">';
    html += ' <button class="btn btn-danger removess" onclick="$(\'.rmvfield' + rows + '\').remove();" type="button"><i class="fa fa-trash"></i></button>';
    html += ' </span>';
    html += ' </div></div>';
    html += ' </div>';
    $('#bundle-product').append(html);
    rows++;
  }
});

$('#bundle-product').delegate('.fa-minus-circle', 'click', function() {
  $(this).parent().remove();
});

/// Categories
$('input[name=\'category\']').autocomplete({
  'source': function(request, response) {
    $.ajax({
      url: 'index.php?route=extension/bundlecategory/autocomplete&user_token={{ user_token }}&filter_name=' +  encodeURIComponent(request),
      dataType: 'json',
      success: function(json) {
        response($.map(json, function(item) {
          return {
            label: item['name'],
            value: item['bundle_category_id'],
          }
        }));
      }
    });
  },
  'select': function(item) {
    $('input[name=\'category\']').val('');

    $('#bundle-category' + item['value']).remove();

    $('#bundle-category').append('<div id="bundle-category' + item['value'] + '"><i class="fa fa-minus-circle"></i> ' + item['label'] + '<input type="hidden" name="bundle_category[]" value="' + item['value'] + '" /></div>');
  }
});

$('#bundle-category').delegate('.fa-minus-circle', 'click', function() {
  $(this).parent().remove();
});
</script>

<!-- Seo -->
<script type="text/javascript">
$(document).on('click','#button-seourls',function() {
  rel=$(this).attr('rel');
  rel1=$(this).attr('rel1');
  title=$('#input-name'+rel1).val();
  $.ajax({
    url: 'index.php?route=extension/bundleproduct/SeoText&user_token={{ user_token }}&title='+title,
    type: 'post',
    data: '',
    dataType: 'json',
    beforeSend: function() {
    },
    complete: function() {
    },
    success: function(json) {
      if (json['success']) {
        $('input[name=\'bundle_seo_url['+rel+']['+rel1+']\']').val(json['title']);
      }
    },
  });
});
</script>
<!-- Seo -->