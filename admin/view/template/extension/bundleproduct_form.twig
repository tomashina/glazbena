          <div class="form-group">
            <label class="col-sm-2 control-label">{{ entry_discount }}</label>
            <div class="col-sm-10">
              <div class="table-responsive">
                <table id="discount" class="table table-striped table-bordered table-hover">
                  <thead>
                    <th class="text-left">{{ entry_customergroup }}</th> 
                    <th class="text-left">{{ entry_doption }}</th> 
                    <th class="text-left">{{ entry_adddiscount }}</th> 
                  </thead>
                  <tbody>
                    {% for group in customer_groups %}
                    <tr>
                      <td class="text-left">{{ group.name }}</td>
                      <td class="text-left">

                        <div class="form-group">
                          <div class="col-sm-10">
                            <select name="customer_group[{{ group.customer_group_id }}][discount_option]" id="input-discount_option" class="form-control">
                              {% if customer_group[group.customer_group_id]['discount_option'] == 'Percentage' %}
                                <option value="Percentage" selected="selected">{{ text_percent }}</option>
                                <option value="Fixed">{{ text_fixed }}</option>
                                {% else %}
                                <option value="Percentage">{{ text_percent }}</option>
                                <option value="Fixed" selected="selected">{{ text_fixed }}</option>
                                {% endif %}
                              </select>
                            </select>
                          </div>
                        </div>

                      </td>
                      <td class="text-left"><input type="text" name="customer_group[{{ group.customer_group_id }}][add_discount]" value="{% if customer_group[group.customer_group_id]%}{{ customer_group[group.customer_group_id].add_discount }}{% endif %}" placeholder="{{ entry_adddiscount }}" class="form-control" /></td>
                    </tr>
                    {% endfor %}
                  </tbody>
                </table>
              </div>
            </div>
          </div>

          <div class="form-group">
            <label class="col-sm-2 control-label" for="input-sort-order">{{ entry_sort_order }}</label>
            <div class="col-sm-10">
              <input type="text" name="sort_order" value="{{ sort_order }}" placeholder="{{ entry_sort_order }}" id="input-sort-order" class="form-control" />
            </div>
          </div>
          <div class="form-group">
            <label class="col-sm-2 control-label" for="input-status">{{ entry_status }}</label>
            <div class="col-sm-10">
              <select name="status" id="input-status" class="form-control">
                {% if status %}
                    <option value="1" selected="selected">{{ text_enabled }}</option>
                    <option value="0">{{ text_disabled }}</option>
                    {% else %}
                    <option value="1">{{ text_enabled }}</option>
                    <option value="0" selected="selected">{{ text_disabled }}</option>
                    {% endif %}
              </select>
            </div>
          </div>
          <div class="form-group">
            <label class="col-sm-2 control-label" for="input-product"><span data-toggle="tooltip" title="{{ help_product }}">{{ entry_product }}</span></label>
            <div class="col-sm-10">
              <input type="text" name="product" value="" placeholder="{{ entry_product }}" id="input-product" class="form-control" />
              <div id="bundle-product" class="well" style="height: 500px; overflow: auto;">
                {% set rows = 0 %}
                {% for bundle_product in bundle_products %}
                <div class="form-group rmvfield{{ rows }}">
                  <label class="col-sm-3 control-label" for="input-qty{{ bundle_product.product_id }}">{{ bundle_product.name }}</label>
                  <div class="col-sm-6">
                    <div class="input-group">
                      <input type="hidden" name="bundle_product[{{ bundle_product.product_id }}][product_id]" value="{{ bundle_product.product_id }}" placeholder="{{ bundle_product.name }}" id="input-quantity{{ bundle_product.product_id }}" class="form-control">


                      <div class="row">
                       <label class="col-sm-3 control-label" >Količina</label>
                      <input type="text" style="max-width:200px" name="bundle_product[{{ bundle_product.product_id }}][quantity]" value="{{ bundle_product.quantity }}" placeholder="Količina" id="input-quantity{{ bundle_product.product_id }}" class="form-control col-sm-9">
                      </div>

                     
                       <div class="row">
                          <label class="col-sm-3 control-label" >Poredak</label>
                          <input type="text" style="max-width:200px" name="bundle_product[{{ bundle_product.product_id }}][sort_order]" value="{{ bundle_product.sort_order }}" placeholder="Poredak" id="input-id_default{{ bundle_product.product_id }}" class="form-control col-sm-9">
                      </div>

                      <div class="row">
                            <label class="col-sm-3 control-label" >Pokaži na artiklu</label>
                           <select style="max-width:200px" name="bundle_product[{{ bundle_product.product_id }}][id_default]" id="input-id_default{{ bundle_product.product_id }}" class="form-control col-sm-9">
                                {% if bundle_product.id_default %}
                                  <option value="1" selected="selected">{{ text_enabled }}</option>
                                  <option value="0">{{ text_disabled }}</option>
                                  {% else %}
                                  <option value="1">{{ text_enabled }}</option>
                                  <option value="0" selected="selected">{{ text_disabled }}</option>
                                {% endif %}
                           </select>

                      </div>

                      <span class="input-group-btn">
                        <button class="btn btn-danger" onclick="$('.rmvfield{{ rows }}').remove();" type="button"><i class="fa fa-trash"></i></button>
                      </span>
                    </div>
                  </div>
                </div>
                {% set rows = rows + 1 %}
                {% endfor %}
              </div>
            </div>
          </div>
          <div class="form-group">
            <label class="col-sm-2 control-label" for="input-category"><span data-toggle="tooltip" title="{{ help_category }}">{{ entry_category }}</span></label>
            <div class="col-sm-10">
              <input type="text" name="category" value="" placeholder="{{ entry_category }}" id="input-category" class="form-control" />
              <div id="bundle-category" class="well well-sm" style="height: 150px; overflow: auto;"> 
                {% for bundle_category in bundle_categories %}
                <div id="bundle-category{{ bundle_category.bundle_category_id }}"><i class="fa fa-minus-circle"></i> {{ bundle_category.name }}
                  <input type="hidden" name="bundle_category[]" value="{{ bundle_category.bundle_category_id }}" />
                </div>
                {% endfor %}</div>
            </div>
          </div>
         <div class="form-group">
          <label class="col-sm-2 control-label">{{ entry_store }}</label>
          <div class="col-sm-10">
            <div class="well well-sm" style="height: 150px; overflow: auto;">
              {% for store in stores %}
              <div class="checkbox">
                <label>
                  {% if store.store_id in bundleproduct_store %}
                  <input type="checkbox" name="bundleproduct_store[]" value="{{ store.store_id }}" checked="checked" />
                  {{ store.name }}
                  {% else %}
                  <input type="checkbox" name="bundleproduct_store[]" value="{{ store.store_id }}" />
                  {{ store.name }}
                  {% endif %}
                </label>
              </div>
              {% endfor %}
            </div>
          </div>
        </div>
        </form>
      </div>
    </div>
  </div>
</div>
{{ footer }}
