{{ header }}{{ column_left }}
<div id="content">
  <div class="page-header">
    <div class="container-fluid">
      <div class="pull-right">
        <button type="submit" form="form-module" data-toggle="tooltip" title="{{ button_save }}" class="btn btn-primary"><i class="fa fa-save"></i></button>
        <a href="{{ cancel }}" data-toggle="tooltip" title="{{ button_cancel }}" class="btn btn-default"><i class="fa fa-reply"></i></a></div>
        <h1>{{ heading_title }}</h1>
      <ul class="breadcrumb">
        {% for breadcrumb in breadcrumbs %}
        <li><a href="{{ breadcrumb.href }}">{{ breadcrumb.text }}</a></li>
        {% endfor %}
      </ul>
    </div>
  </div>
  <div class="container-fluid">
    {% if error_warning %}
    <div class="alert alert-danger alert-dismissible"><i class="fa fa-exclamation-circle"></i> {{ error_warning }}
      <button type="button" class="close" data-dismiss="alert">&times;</button>
    </div>
    {% endif %}
    <div class="panel panel-default">
      <div class="panel-heading">
        <h3 class="panel-title"><i class="fa fa-pencil"></i> {{ text_edit }}</h3>
      </div>
      <div class="panel-body">
	  {% if error_keynotfound %}
				<div class="alert alert-danger"><i class="fa fa-exclamation-circle"></i> {{ error_keynotfound }}
				  <button type="button" class="close" data-dismiss="alert">&times;</button>
				</div>
			{% endif %} 
			<div class="loadlicensekey" style="display:none"></div>
        <form action="{{ action }}" method="post" enctype="multipart/form-data" id="form-module" class="form-horizontal">
          <ul class="nav nav-tabs">
            <li class="active"><a href="#tab-language" data-toggle="tab">{{ tab_language }}</a></li>
            <li class=""><a href="#tab-Setting" data-toggle="tab">{{ tab_setting }}</a></li>
          </ul>
          <div class="tab-content">
            <div class="tab-pane active" id="tab-language">
              <ul class="nav nav-tabs" id="language">
                {% for language in languages %}
               <li><a href="#language{{ language.language_id }}" data-toggle="tab"><img src="language/{{ language.code }}/{{ language.code }}.png" title="{{ language.name }}" /> {{ language.name }}</a></li>
                {% endfor %}
              </ul>
              <div class="tab-content">
                {% for language in languages %}
                <div class="tab-pane" id="language{{ language.language_id }}">
                  <div class="form-group">
                    <label class="col-sm-2 control-label" for="input-filter"><span data-toggle="tooltip" title="{{ help_title }}">{{ entry_title }}</span></label>
                    <div class="col-sm-10">
                      <input type="text" name="module_bundle_languageseting[{{ language.language_id }}][title]" value="{{ module_bundle_languageseting[language.language_id] ? module_bundle_languageseting[language.language_id].title }}" placeholder="{{ entry_title }}" id="input-title" class="form-control"/>
                    </div>
                  </div>
                  <div class="form-group">
                    <label class="col-sm-2 control-label" for="input-filter"><span data-toggle="tooltip" title="{{ help_description }}">{{ entry_description }}</span></label>
                    <div class="col-sm-10">
                      <textarea type="text" name="module_bundle_languageseting[{{ language.language_id }}][description]" rows="5" placeholder="{{ entry_description }}" id="input-description" class="form-control">{{ module_bundle_languageseting[language.language_id] ? module_bundle_languageseting[language.language_id].description }}</textarea>
                    </div>
                  </div>
                  <legend><h3>{{ heading_bundleshoppingcart }}</h3></legend>
                  <div class="form-group">
                    <label class="col-sm-2 control-label" for="input-filter">{{ entry_bundleheading }}</label>
                    <div class="col-sm-10">
                      <input type="text" name="module_bundle_languageseting[{{ language.language_id }}][bundleheading]" value="{{ module_bundle_languageseting[language.language_id] ? module_bundle_languageseting[language.language_id].bundleheading }}" placeholder="{{ entry_title }}" id="input-bundleheading" class="form-control"/>
                    </div>
                  </div>
                  <div class="form-group">
                    <label class="col-sm-2 control-label" for="input-filter">{{ entry_image }}</label>
                    <div class="col-sm-10">
                      <input type="text" name="module_bundle_languageseting[{{ language.language_id }}][image]" value="{{ module_bundle_languageseting[language.language_id] ? module_bundle_languageseting[language.language_id].image }}" placeholder="{{ entry_image }}" id="input-image" class="form-control"/>
                    </div>
                  </div>
                  <div class="form-group">
                    <label class="col-sm-2 control-label" for="input-filter">{{ entry_productname }}</label>
                    <div class="col-sm-10">
                      <input type="text" name="module_bundle_languageseting[{{ language.language_id }}][productname]" value="{{ module_bundle_languageseting[language.language_id] ? module_bundle_languageseting[language.language_id].productname }}" placeholder="{{ entry_productname }}" id="input-productname" class="form-control"/>
                    </div>
                  </div>
                  <div class="form-group">
                    <label class="col-sm-2 control-label" for="input-filter">{{ entry_model }}</label>
                    <div class="col-sm-10">
                      <input type="text" name="module_bundle_languageseting[{{ language.language_id }}][model]" value="{{ module_bundle_languageseting[language.language_id] ? module_bundle_languageseting[language.language_id].model }}" placeholder="{{ entry_model }}" id="input-model" class="form-control"/>
                    </div>
                  </div>
                  <div class="form-group">
                    <label class="col-sm-2 control-label" for="input-filter">{{ entry_minquantity }}</label>
                    <div class="col-sm-10">
                      <input type="text" name="module_bundle_languageseting[{{ language.language_id }}][minquantity]" value="{{ module_bundle_languageseting[language.language_id] ? module_bundle_languageseting[language.language_id].minquantity }}" placeholder="{{ entry_minquantity }}" id="input-minquantity" class="form-control"/>
                    </div>
                  </div>
                  <div class="form-group">
                    <label class="col-sm-2 control-label" for="input-filter">{{ entry_price }}</label>
                    <div class="col-sm-10">
                      <input type="text" name="module_bundle_languageseting[{{ language.language_id }}][price]" value="{{ module_bundle_languageseting[language.language_id] ? module_bundle_languageseting[language.language_id].price }}" placeholder="{{ entry_price }}" id="input-price" class="form-control"/>
                    </div>
                  </div>
                  <div class="form-group">
                    <label class="col-sm-2 control-label" for="input-filter">{{ entry_availability }}</label>
                    <div class="col-sm-10">
                      <input type="text" name="module_bundle_languageseting[{{ language.language_id }}][availability]" value="{{ module_bundle_languageseting[language.language_id] ? module_bundle_languageseting[language.language_id].availability }}" placeholder="{{ entry_availability }}" id="input-availability" class="form-control"/>
                    </div>
                  </div>
                  <div class="form-group">
                    <label class="col-sm-2 control-label" for="input-filter">{{ entry_option }}</label>
                    <div class="col-sm-10">
                      <input type="text" name="module_bundle_languageseting[{{ language.language_id }}][option]" value="{{ module_bundle_languageseting[language.language_id] ? module_bundle_languageseting[language.language_id].option }}" placeholder="{{ entry_option }}" id="input-option" class="form-control"/>
                    </div>
                  </div>
                  <div class="form-group">
                    <label class="col-sm-2 control-label" for="input-filter">{{ entry_addtocart }}</label>
                    <div class="col-sm-10">
                      <input type="text" name="module_bundle_languageseting[{{ language.language_id }}][addtocart]" value="{{ module_bundle_languageseting[language.language_id] ? module_bundle_languageseting[language.language_id].addtocart }}" placeholder="{{ entry_addtocart }}" id="input-option" class="form-control"/>
                    </div>
                  </div>
                  <div class="form-group">
                    <label class="col-sm-2 control-label" for="input-filter">{{ entry_continueshopping }}</label>
                    <div class="col-sm-10">
                      <input type="text" name="module_bundle_languageseting[{{ language.language_id }}][continueshopping]" value="{{ module_bundle_languageseting[language.language_id] ? module_bundle_languageseting[language.language_id].continueshopping }}" placeholder="{{ entry_continueshopping }}" id="input-continueshopping" class="form-control"/>
                    </div>
                  </div>
                  <legend><h3>{{ heading_bundleproduct }}</h3></legend>
                  <div class="form-group">
                    <label class="col-sm-2 control-label" for="input-filter">{{ entry_bundleproduct }}</label>
                    <div class="col-sm-10">
                      <input type="text" name="module_bundle_languageseting[{{ language.language_id }}][bundleproduct]" value="{{ module_bundle_languageseting[language.language_id] ? module_bundle_languageseting[language.language_id].bundleproduct }}" placeholder="{{ entry_bundleproduct }}" id="input-bundleproduct" class="form-control"/>
                    </div>
                  </div>
                  <div class="form-group">
                    <label class="col-sm-2 control-label" for="input-filter">{{ entry_yousave }}</label>
                    <div class="col-sm-10">
                      <input type="text" name="module_bundle_languageseting[{{ language.language_id }}][yousave]" value="{{ module_bundle_languageseting[language.language_id] ? module_bundle_languageseting[language.language_id].yousave }}" placeholder="{{ entry_yousave }}" id="input-yousave" class="form-control"/>
                    </div>
                  </div>

                  <div class="form-group">
                    <label class="col-sm-2 control-label" for="input-filter">{{ entry_regularprice }}</label>
                    <div class="col-sm-10">
                      <input type="text" name="module_bundle_languageseting[{{ language.language_id }}][regularprice]" value="{{ module_bundle_languageseting[language.language_id] ? module_bundle_languageseting[language.language_id].regularprice }}" placeholder="{{ entry_regularprice }}" id="input-regularprice" class="form-control"/>
                    </div>
                  </div>
                  <div class="form-group">
                    <label class="col-sm-2 control-label" for="input-filter">{{ entry_taxprice }}</label>
                    <div class="col-sm-10">
                      <input type="text" name="module_bundle_languageseting[{{ language.language_id }}][taxprice]" value="{{ module_bundle_languageseting[language.language_id] ? module_bundle_languageseting[language.language_id].taxprice }}" placeholder="{{ entry_taxprice }}" id="input-taxprice" class="form-control"/>
                    </div>
                  </div>

                  <div class="form-group">
                    <label class="col-sm-2 control-label" for="input-filter">{{ entry_relatedpro }}</label>
                    <div class="col-sm-10">
                      <input type="text" name="module_bundle_languageseting[{{ language.language_id }}][related_bundle]" value="{{ module_bundle_languageseting[language.language_id] ? module_bundle_languageseting[language.language_id].related_bundle }}" placeholder="{{ entry_relatedpro }}" id="input-yousave" class="form-control"/>
                    </div>
                  </div>
                  <div class="form-group">
                    <label class="col-sm-2 control-label" for="input-filter">{{ entry_allbundle }}</label>
                    <div class="col-sm-10">
                      <input type="text" name="module_bundle_languageseting[{{ language.language_id }}][all_bundle]" value="{{ module_bundle_languageseting[language.language_id] ? module_bundle_languageseting[language.language_id].all_bundle }}" placeholder="{{ entry_allbundle }}" id="input-yousave" class="form-control"/>
                    </div>
                  </div>

                </div>
              {% endfor %}
              </div>
			  
            </div>
            <div class="tab-pane" id="tab-Setting">
              <div class="form-group">
                <label class="col-sm-2 control-label" for="input-filter"><span data-toggle="tooltip" title="{{ help_pagelimit }}">{{ entry_pagelimit }}</span></label>
                <div class="col-sm-10">
                  <input type="text" name="module_bundle_pagelimit" value="{{ module_bundle_pagelimit }}" placeholder="{{ entry_pagelimit }}" id="input-pagelimit" class="form-control"/>
                </div>
              </div>
              <div class="form-group">
                <label class="col-sm-2 control-label" for="input-filter"><span data-toggle="tooltip" title="{{ help_modulelimit }}">{{ entry_modulelimit }}</span></label>
                <div class="col-sm-10">
                  <input type="text" name="module_bundle_modulelimit" value="{{ module_bundle_modulelimit }}" placeholder="{{ entry_modulelimit }}" id="input-modulelimit" class="form-control"/>
                </div>
              </div>
              <div class="form-group">
                <label class="col-sm-2 control-label" for="input-menu">{{ entry_menu }}</label>
                <div class="col-sm-10">
                  <select name="module_bundle_menu" id="input-menu" class="form-control">
                    {% if module_bundle_menu %}
                    <option value="1" selected="selected">{{ text_yes }}</option>
                    <option value="0">{{ text_no }}</option>
                    {% else %}
                    <option value="1">{{ text_yes }}</option>
                    <option value="0" selected="selected">{{ text_no }}</option>
                    {% endif %}
                  </select>
                </div>
              </div>
              <div class="form-group">
                <label class="col-sm-2 control-label" for="input-status">{{ entry_status }}</label>
                <div class="col-sm-10">
                  <select name="module_bundle_status" id="input-status" class="form-control">
                    {% if module_bundle_status %}
                    <option value="1" selected="selected">{{ text_enabled }}</option>
                    <option value="0">{{ text_disabled }}</option>
                    {% else %}
                    <option value="1">{{ text_enabled }}</option>
                    <option value="0" selected="selected">{{ text_disabled }}</option>
                    {% endif %}
                  </select>
                </div>
              </div>
			  <!--/* new work */-->
			  <div class="form-group">
                <label class="col-sm-2 control-label" for="input-image">{{ entry_image }}</label>
                <div class="row">
                  <div class="col-sm-4">
                    <input type="number" name="module_bundle_height" value="{{ module_bundle_height }}" placeholder="{{ entry_height }}" id="input-height" class="form-control"/>
                  </div>
                  <div class="col-sm-4">
                    <input type="number" name="module_bundle_width" value="{{ module_bundle_width }}" placeholder="{{ entry_width }}" id="input-width" class="form-control"/>
                  </div>
                </div>
              </div>
			  <!--/* new work */-->
            </div>
           </div>
        </form>
      </div>
    </div>
  </div>
</div><script type="text/javascript"><!--
$('#language a:first').tab('show');
//--></script>
<script type="text/javascript"><!--
			$(document).ready(function() {
				$('.loadlicensekey').load('index.php?route=extension/module/keysubmit/loadfrom&user_token={{user_token}}');
				});
			//--></script>
{{ footer }}
