{{ header }}{{ column_left }}
<div id="content">
  <div class="page-header">
    <div class="container-fluid">
      <div class="pull-right">
        <button type="submit" form="form-module" data-toggle="tooltip" title="{{ button_save }}" class="btn btn-primary"><i class="fa fa-save"></i></button>
        <a href="{{ cancel }}" data-toggle="tooltip" title="{{ button_cancel }}" class="btn btn-default"><i class="fa fa-reply"></i></a>
      </div>
      <h1>{{ heading_title }}</h1>
      <ul class="breadcrumb">
        {% for breadcrumb in breadcrumbs %}
        <li><a href="{{ breadcrumb.href }}">{{ breadcrumb.text }}</a></li>
        {% endfor %}
      </ul>
    </div>
  </div>
  <div class="container-fluid">
    {% if error_warning %}
    <div class="alert alert-danger alert-dismissible"><i class="fa fa-exclamation-circle"></i> {{ error_warning }}
      <button type="button" class="close" data-dismiss="alert">&times;</button>
    </div>
    {% endif %}
    <div class="panel panel-default">
      <div class="panel-heading">
        <h3 class="panel-title"><i class="fa fa-facebook-official"></i> {{ text_edit }}</h3>
      </div>
      <div class="panel-body">
        <form action="{{ action }}" method="post" enctype="multipart/form-data" id="form-module" class="form-horizontal">
          <div class="form-group">
            <label class="col-sm-2 control-label" for="input-status">{{ entry_status }}</label>
            <div class="col-sm-10">
              <select name="module_javv_meta_pixel_status" id="input-status" class="form-control">
                {% if module_javv_meta_pixel_status %}
                <option value="1" selected="selected">{{ text_enabled }}</option>
                <option value="0">{{ text_disabled }}</option>
                {% else %}
                <option value="1">{{ text_enabled }}</option>
                <option value="0" selected="selected">{{ text_disabled }}</option>
                {% endif %}
              </select>
            </div>
          </div>
          <div class="form-group">
            <label class="col-sm-2 control-label" for="input-pixel-id"><span data-toggle="tooltip" title="{{ help_pixel_id }}">{{ entry_pixel_id }}</span></label>
            <div class="col-sm-10">
              <input type="text" name="module_javv_meta_pixel_pixel_id" value="{{ module_javv_meta_pixel_pixel_id }}" placeholder="{{ entry_pixel_id }}" id="input-pixel-id" class="form-control" />
              {% if error_pixel_id %}
              <div class="text-danger">{{ error_pixel_id }}</div>
              {% endif %}
            </div>
          </div>
          <fieldset>
            <legend>{{ text_events }}</legend>
            <div class="form-group">
              <label class="col-sm-2 control-label" for="input-page-view-status"><span data-toggle="tooltip" title="{{ help_page_view_status }}">{{ entry_page_view_status }}</span></label>
              <div class="col-sm-10">
                <select name="module_javv_meta_pixel_page_view_status" id="input-page-view-status" class="form-control">
                  {% if module_javv_meta_pixel_page_view_status %}
                  <option value="1" selected="selected">{{ text_enabled }}</option>
                  <option value="0">{{ text_disabled }}</option>
                  {% else %}
                  <option value="1">{{ text_enabled }}</option>
                  <option value="0" selected="selected">{{ text_disabled }}</option>
                  {% endif %}
                </select>
              </div>
            </div>
            <div class="form-group">
              <label class="col-sm-2 control-label" for="input-add-to-cart-status"><span data-toggle="tooltip" title="{{ help_add_to_cart_status }}">{{ entry_add_to_cart_status }}</span></label>
              <div class="col-sm-10">
                <select name="module_javv_meta_pixel_add_to_cart_status" id="input-add-to-cart-status" class="form-control">
                  {% if module_javv_meta_pixel_add_to_cart_status %}
                  <option value="1" selected="selected">{{ text_enabled }}</option>
                  <option value="0">{{ text_disabled }}</option>
                  {% else %}
                  <option value="1">{{ text_enabled }}</option>
                  <option value="0" selected="selected">{{ text_disabled }}</option>
                  {% endif %}
                </select>
              </div>
            </div>
            <div class="form-group">
              <label class="col-sm-2 control-label" for="input-purchase-status"><span data-toggle="tooltip" title="{{ help_purchase_status }}">{{ entry_purchase_status }}</span></label>
              <div class="col-sm-10">
                <select name="module_javv_meta_pixel_purchase_status" id="input-purchase-status" class="form-control">
                  {% if module_javv_meta_pixel_purchase_status %}
                  <option value="1" selected="selected">{{ text_enabled }}</option>
                  <option value="0">{{ text_disabled }}</option>
                  {% else %}
                  <option value="1">{{ text_enabled }}</option>
                  <option value="0" selected="selected">{{ text_disabled }}</option>
                  {% endif %}
                </select>
              </div>
            </div>
            <div class="form-group">
              <label class="col-sm-2 control-label" for="input-debug-status"><span data-toggle="tooltip" title="{{ help_debug_status }}">{{ entry_debug_status }}</span></label>
              <div class="col-sm-10">
                <select name="module_javv_meta_pixel_debug_status" id="input-debug-status" class="form-control">
                  {% if module_javv_meta_pixel_debug_status %}
                  <option value="1" selected="selected">{{ text_enabled }}</option>
                  <option value="0">{{ text_disabled }}</option>
                  {% else %}
                  <option value="1">{{ text_enabled }}</option>
                  <option value="0" selected="selected">{{ text_disabled }}</option>
                  {% endif %}
                </select>
              </div>
            </div>
          </fieldset>
        </form>
      </div>
    </div>
  </div>
</div>
{{ footer }}
