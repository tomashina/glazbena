<div id="featherlight-holder"></div>




<script>
(function() {
  function loadCookieConsent() {
    if (window.gkCookieConsentLoading) return;
    window.gkCookieConsentLoading = true;
    var core = document.createElement('script');
    core.src = 'catalog/view/javascript/cookieconsent/cookieconsent.umd.js?v=3.1';
    core.onload = function() {
      var config = document.createElement('script');
      config.src = 'catalog/view/javascript/cookieconsent/glazbena-consent.js?v=1.4';
      document.head.appendChild(config);
    };
    document.head.appendChild(core);
  }
  if ('requestAnimationFrame' in window) {
    requestAnimationFrame(function() { setTimeout(loadCookieConsent, 100); });
  } else {
    setTimeout(loadCookieConsent, 100);
  }
})();
</script>
<script>
(function(){
  var frames=document.querySelectorAll('iframe.gk-deferred-iframe[data-src]');
  if(!frames.length){return;}
  var load=function(frame){if(frame.dataset.src){frame.src=frame.dataset.src;frame.removeAttribute('data-src');}};
  if('IntersectionObserver' in window){
    var observer=new IntersectionObserver(function(entries){entries.forEach(function(entry){if(entry.isIntersecting){load(entry.target);observer.unobserve(entry.target);}});},{rootMargin:'0px'});
    Array.prototype.forEach.call(frames,function(frame){observer.observe(frame);});
  }else{
    var activate=function(){Array.prototype.forEach.call(frames,load);window.removeEventListener('scroll',activate);window.removeEventListener('touchstart',activate);};
    window.addEventListener('scroll',activate,{once:true,passive:true});window.addEventListener('touchstart',activate,{once:true,passive:true});
  }
})();
</script>



