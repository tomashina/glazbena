<meta property="og:locale" content="{{ seo.og_locale }}" />
{% if seo.og_image %}<meta property="og:image" content="{{ seo.og_image }}" />{% endif %}
{% if seo.product_price %}<meta property="product:price:amount" content="{{ seo.product_price }}" />
<meta property="product:price:currency" content="{{ seo.product_currency }}" />
<meta property="product:availability" content="{{ seo.product_available }}" />{% endif %}
<meta name="twitter:card" content="{{ seo.twitter_card }}" />
