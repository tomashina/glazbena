<style id="gk-accessibility-overrides">.price-new{color:#b00000!important}.single-product .price .price-old{color:#595959!important}.instock{color:#087a00!important}button.menu-trigger,button.menu-closer{color:#fff!important}.gk-cookie-fab{bottom:22px!important}button.scroll-to-top{position:fixed;right:18px;bottom:18px;z-index:980;display:flex;width:60px;height:60px;align-items:center;justify-content:center;padding:0;border:0;border-radius:50%;background:#0966b3!important;color:#fff!important;font-size:18px;line-height:1;transform:rotate(-90deg);visibility:hidden;opacity:0;transition:opacity .3s,visibility .3s,background .2s}.offset250 button.scroll-to-top{bottom:18px;visibility:visible;opacity:1}button.scroll-to-top:hover,button.scroll-to-top:focus{background:#074f8b!important;color:#fff!important}.footer-copyright>.col-md-6:last-child{display:flex;flex-wrap:wrap;align-items:center;gap:4px}@media(max-width:1199px){.gk-cookie-fab{display:none!important}}</style>
