@media(min-width:768px){.common-home .carousel:hover .slick-arrow:not(.slick-hidden),.common-home .carousel:focus-within .slick-arrow:not(.slick-hidden),body[class*="product-product"] .grid-holder.related:hover .slick-arrow:not(.slick-hidden),body[class*="product-product"] .grid-holder.related:focus-within .slick-arrow:not(.slick-hidden){opacity:1!important;visibility:visible!important;pointer-events:auto}.common-home .carousel:hover .slick-disabled,body[class*="product-product"] .grid-holder.related:hover .slick-disabled{opacity:.38!important;cursor:default}}
