<div class="header-wrapper header1 fixed-header-possible">
<span class="table header-main sticky-header-placeholder">&nbsp;</span>
<div class="sticky-header outer-container header-style">
{% if main_header_width == 'boxed' %}
<div class="container boxed">
{% else %}
<div class="container">
{% endif %}
<div class="table header-main">

<div class="table-cell w40 menu-cell hidden-xs hidden-sm">
{% if primary_menu %}
<div class="main-menu menu-stay-left">
	<ul class="categories">
        <li class="">
<a class=" " href="{{ home }}">

<span class="top homeicon"> <img src="image/homeicon.svg" alt="Početna"> </span>
</a>
</li>
		{% if primary_menu == 'oc' %}
        <!-- Default menu -->
        {{ default_menu }}
      {% elseif primary_menu is defined %}
        <!-- Mega menu -->
        {% for key, row in primary_menu_desktop %}
        {% include 'basel/template/common/menus/mega_menu.twig' %}
        {% endfor %}
      {% endif %}
    </ul>
    {% if header_search %}
        <div class="icon-element srhpd">
            <div class="dropdown-wrapper-click from-top hidden-sx hidden-sm hidden-xs">
                <button type="button" class="shortcut-wrapper search-trigger from-top clicker" aria-label="Pretraži">
                    <i class="icon-magnifier icon" aria-hidden="true"></i>
                </button>
                <div class="dropdown-content dropdown-left smarg">
                    <div class="search-dropdown-holder">
                        <div class="search-holder">
                            {{ basel_search }}
                        </div>
                    </div>
                </div>
            </div>
        </div>
    {% endif %}

    <div class="icon-element is_wishlist hidden-sx hidden-sm hidden-xs">
        {% if lang_curr_title %}
            <div class="setting-ul">
                <div class="setting-li dropdown-wrapper from-left lang-curr-trigger nowrap"><button type="button" aria-label="Odabir valute">
                        <span>
                      {{ lang_curr_title }}

                        </span>
                    </button>
                    <div class="dropdown-content dropdown-left lang-curr-wrapper">

                        {{ currency }}
                    </div>
                </div>
            </div>
        {% endif %}
    </div>
</div>
{% endif %}
</div>




<div class="table-cell w20 logo text-center">
    {% if logo %}
    <div id="logo" >
    <a href="{{ home }}" class="normal" ><img src="image/logo-glazbena.png" class="normal" width="200" height="132" title="{{ name }}" alt="{{ name }}" /></a>

     <a href="{{ home }}" class="sticky" ><img src="image/logo-glazbena-sticky.png" class="sticky" width="73" height="60" title="{{ name }}" alt="{{ name }}" /></a>
    </div>
    {% endif %}
</div>
<div class="table-cell w40 shortcuts text-right">
   <div class="font-zero">





    <div class="icon-element is_wishlist hidden-sx hidden-sm hidden-xs">
        {% if lang_curr_title %}
            <div class="setting-ul">
                <div class="setting-li dropdown-wrapper from-left lang-curr-trigger nowrap"><button type="button" aria-label="Odabir jezika">
                        <span> {% if code =='hr' %}
                                <img class="flag" src="image/hr.svg" alt="Hrvatski">

               {% else %}

                                <img class="flag" src="image/gb.svg" alt="English">
                            {% endif %}</span>
                    </button>
                    <div class="dropdown-content dropdown-left lang-curr-wrapper">
                        {{ language }}

                    </div>
                </div>
            </div>
        {% endif %}
    </div>

       <div class="icon-element is_wishlist hidden-sx hidden-sm hidden-xs socijal">
           <a class="shortcut-wrapper wishlist" href="contact">
               <div class="wishlist-hover"> <span class=" hidden-sm hidden-xs">{{ basel_text_kontakt }}</span>
               </div>
           </a>
           <a class="socka" href="https://www.facebook.com/GlazbenaKutijaDoo" aria-label="Facebook"><img src="image/facebook.svg" alt=""></a>
               <a class="socka" href="https://www.instagram.com/glazbenakutija/" aria-label="Instagram"><img src="image/instagram.svg" alt=""></a>
                   <a class="sockak" href="https://www.youtube.com/channel/UCgDP1zd_7Y7lHbvxqqfu0HA" aria-label="YouTube"><img src="image/youtube.svg" alt=""></a>

       </div>

    {% if header_login %}
       <div class="icon-element userlog is_wishlist">

        {% if logged %}
            <a class="shortcut-wrapper wishlist" style="padding-right: 0px" href="{{ account }}" aria-label="Korisnički račun"><div class="wishlist-hover"><img src="image/user.svg" alt=""> </div></a>  <a class="anim-underline hidden-sm hidden-xs" style="font-size:13px;font-weight:300" href="{{ logout }}">{{ text_logout }}</a> &nbsp;<!--  /
        -->
        {% else %}
            <a class="shortcut-wrapper wishlist" href="{{ login }}" aria-label="{{ basel_text_racun }}">  <div class="wishlist-hover"><img src="image/user.svg" alt=""> <span class="hidden-md hidden-sm hidden-xs">{{ basel_text_racun }}</span> </div></a>
        {% endif %}

    </div>
    {% endif %}


        <div class="icon-element catalog_hide">
            <div id="cart" class="dropdown-wrapper from-top">
                <a href="{{ shopping_cart }}" class="shortcut-wrapper cart">
                    <img src="image/kosarica-white.svg" class="carticonm" alt=""/> <span id="cart-total" class="nowrap">
                        <span class="counter cart-total-items">{{ cart_items }}</span>
                </span>
                </a>
                    <div class="dropdown-content dropdown-right hidden-sm hidden-xs">
                {{ cart }}
                </div>
            </div>
        </div>

       <div class="icon-element mnu">
           <button type="button" class="shortcut-wrapper menu-trigger hidden-md hidden-lg" aria-label="Otvori izbornik">
               <i class="icon-line-menu icon" aria-hidden="true"></i>
           </button>
       </div>

       <div class="icon-element srch dropdown-wrapper-click">
           <button type="button" class="shortcut-wrapper search-trigger hidden-md hidden-lg clicker" aria-label="Pretraži">
               <i class="icon-magnifier icon" aria-hidden="true"></i>
           </button>
           <div class="dropdown-content dropdown-left mobl">
               <div class="search-dropdown-holder mob">
                   <div class="search-holder">
                       <div class="search-field sbigtri">



                           <input type="text" name="search" value="" placeholder="Traži" class="form-control main-search-input mstri" style="box-sizing:border-box !important;width:100% !important;max-width:100% !important;font-size:16px !important;" >

                          <span class="btn btn-contrast do-searchmobile main"></span>


                       </div>
                   </div>
               </div>
           </div>

        </div>





</div>
</div> <!-- .table.header_main ends -->

</div> <!-- .container ends -->
</div> <!-- .sticky ends -->

</div> <!-- .header_wrapper ends -->
</div>
