<script>
(function() {
  $(function() {
    $('img:not([alt])').each(function() {
      var parent = this.closest ? this.closest('a[title]') : null;
      this.alt = parent ? parent.getAttribute('title') : '';
    });
  });

  var holder = document.querySelector('[data-sharethis-lazy]');
  if (!holder) return;
  var loaded = false;
  function loadShareThis() {
    if (loaded) return;
    loaded = true;
    var script = document.createElement('script');
    script.async = true;
    script.src = 'https://platform-api.sharethis.com/js/sharethis.js#property=5f1aa4948aa12700134b0c47&product=inline-share-buttons';
    document.head.appendChild(script);
  }
  holder.addEventListener('pointerenter', loadShareThis, {once:true});
  holder.addEventListener('focusin', loadShareThis, {once:true});
  if ('IntersectionObserver' in window) {
    var observer = new IntersectionObserver(function(entries) {
      if (entries.some(function(entry) { return entry.isIntersecting; })) {
        observer.disconnect();
        loadShareThis();
      }
    }, {rootMargin:'150px'});
    observer.observe(holder);
  }
})();
</script>



<script type="text/javascript"><!--
  $(document).on('click', '.number-spinner button', function () {
    var btn = $(this),
      oldValue = btn.closest('.number-spinner').find('input').val().trim(),
      newVal = 1;

    if (btn.attr('data-dir') == 'up') {
      newVal = parseInt(oldValue) + 1;
    } else {
      if (oldValue > 1) {
        newVal = parseInt(oldValue) - 1;
      } else {
        newVal = 1;
      }
    }
    btn.closest('.number-spinner').find('input').val(newVal);
  });
  //--></script>
