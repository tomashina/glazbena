 <img src="{{ thumb }}" width="{{ img_w }}" height="{{ img_h }}" title="{{ custom_imgtitle ? custom_imgtitle : heading_title }}" class="img-thumbnail" alt="{{ custom_alt ? custom_alt : heading_title }}" fetchpriority="high" decoding="async" /></a></div>
  
  

{% for image in images %}
