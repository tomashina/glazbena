<div class="item single-product">
<div class="image" {% if columns == 'list' %}style="width:{{ img_width }}px"{% endif %}>
    <a href="{{ product.href }}">
    <img {% if product.thumb2 %} class="thumb1"  {% endif %} loading="lazy" width="400" height="400" src="{{ product.thumb }}" alt="{{ product.name }}" title="{{ product.name }}" />
    {% if product.thumb2 %}
    <img class="thumb2" src="{{ product.thumb2 }}" loading="lazy" width="400" height="400" alt="{{ product.name }}" title="{{ product.name }}" />
    {% endif %}
    </a>
{% if product.price and product.special and salebadge_status %}
    <div class="sale-counter id{{ product.product_id }}"></div>
     <a  href="{{ product.href }}"> <span class="badge sale_badge"><i>{{ product.sale_badge }}</i></span></a>
{% endif %}
{% if product.new_label %}
   <a  href="{{ product.href }}"> <span class="badge novo_badge{% if lang =='en'%}en{% endif %}"></span></a>
{% endif %}



{% if product.jan %}
 <a  href="{{ product.href }}">   <span class="badge hot_badge"></span></a>
{% endif %}
{% if ((product.quantity < 1) and (stock_badge_status)) %}
   <!-- <span class="badge out_of_stock_badge"><i>{{ basel_text_out_of_stock }}</i></span>-->
    {% set button_cart = basel_text_out_of_stock %}
{% else %}
	{% set button_cart = default_button_cart %}
{% endif %}
<a class="img-overlay" href="{{ product.href }}"></a>
<div class="btn-center catalog_hide"><a class="btn btn-light-outline btn-thin" onclick="cart.add('{{ product.product_id }}', '{{ product.minimum }}');">{{ button_cart }}</a></div>

  {% if product.variants %}
        
                <ul class="swatch-variant">
                    {% for variant in product.variants %}
                    <li>
                        <a href="{{ variant.href }}" title="{{ variant.name }}">
                            <img src="{{ variant.variant_image }}" alt="{{ variant.name }}" />
                        </a>
                    </li>
                    {% endfor %}
                </ul>
               
            {% endif %}


</div><!-- .image ends -->
{% if product.rating %}
    <div class="rating">
   <!-- <span class="rating_stars rating r{{ product.rating }}">
    <i class="fa fa-star-o"></i><i class="fa fa-star-o"></i><i class="fa fa-star-o"></i><i class="fa fa-star-o"></i><i class="fa fa-star-o"></i>
    </span>-->

      <i data-star="{{ product.rating }}"></i>
    </div>
{% endif %}
<div class="caption"><span class="pcatname">{{ product.category }}</span>
<a class="product-name" href="{{ product.href }}">{{ product.name }}</a>


<div class="price-wrapper">
{% if product.price %}
<div class="price">
    {% if product.special %}


                        {% if ( product.price_last_30  >  product.special and  product.price_last_30  <  product.price  ) %}
                            <span class="price-old">{{ basel_30 }} {{ product.price_last_30 }}</span>
                        {% else %}
                            <span class="price-old">{{ basel_30 }} {{ product.price }}</span>
                        {% endif %}

   <span class="price-new">{{ product.special }}</span>
    {% else %}
    <span>{{ product.price }}</span>
    {% endif %}
    {% if product.tax %}
   <!-- <span class="price-tax">{{ text_tax }} {{ product.tax }}</span> -->
    {% endif %}
</div><!-- .price -->
{% endif %}




    
    {% if ((product.quantity < 1) and (stock_badge_status)) %}
   <span class="outofstock" {% if product.stock_id=='5' %}style="color:red" {% endif %} {% if product.stock_id=='9' %}style="color:red" {% endif %} {% if product.stock_id=='8' %}style="color:orange" {% endif %}>{{ product.stock }}</span>
    {% else %}
        <span class="instock">
            


                         
                             {% if product.quantity > 0 and  product.quantity < 16 %}
                                {{ product.quantity }} {{ basel_text_instock }}
                             {% else %}
                             15+  {{ basel_text_instock }}
                             {% endif %}

        </span>
    {% endif %}
    <p class="description">{% if product.description %}{{ product.description }}{% endif %}</p>
    {% if ((product.quantity < 1) and (stock_badge_status)) %}
        <a href="{{ product.href }}" class="btn  {% if basel_list_style == '6' %}btn-contrast outofstock {% else %}btn-outline{% endif %}" ><span class="ikona"></span><img src="image/upit-black.svg" class="carticon">{{ basel_text_upit }}</a>
    {% else %}
        <a class="btn  {% if basel_list_style == '6' %}btn-contrast {% else %}btn-outline{% endif %}" onclick="cart.add('{{ product.product_id }}', '{{ product.minimum }}');"><span class="car"></span><img src="image/kosarica-white.svg" class="carticon">{{ button_cart }}</a>
    {% endif %}

</div><!-- .price-wrapper -->
<div class="plain-links">
<a class="icon is_wishlist link-hover-color" onclick="wishlist.add('{{ product.product_id }}');"><span class="icon-heart"></span> {{ button_wishlist }}</a>
<a class="icon is_compare link-hover-color" onclick="compare.add('{{ product.product_id }}');"><span class="icon-refresh"></span> {{ button_compare }}</a>
<a class="icon is_quickview link-hover-color" onclick="quickview('{{ product.product_id }}');"><span class="icon-magnifier-add"></span> {{ basel_button_quickview }}</a>
</div><!-- .plain-links-->
</div><!-- .caption-->
{% if product.sale_end_date and countdown_status %}
<script>
  $(function() {
	$(".sale-counter.id{{ product.product_id }}").countdown("{{ product.sale_end_date }}").on('update.countdown', function(event) {
  var $this = $(this).html(event.strftime(''
    + '<div>'
    + '%D<i>{{ basel_text_days }}</i></div><div>'
    + '%H <i>{{ basel_text_hours }}</i></div><div>'
    + '%M <i>{{ basel_text_mins }}</i></div><div>'
    + '%S <i>{{ basel_text_secs }}</i></div></div>'));
});
});
</script>
{% endif %}
</div><!-- .single-product ends -->
