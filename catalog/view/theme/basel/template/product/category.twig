{{ header }}
<div class="container">

  <ul class="breadcrumb">
    {% for breadcrumb in breadcrumbs %}
    <li><a href="{{ breadcrumb.href }}" aria-label="{% if loop.first %}Početna{% else %}{{ breadcrumb.text|striptags }}{% endif %}">{{ breadcrumb.text }}</a></li>
    {% endfor %}
  </ul>

    <!-- breadcrumb -->
    <div class="breadcrumb-holder">

            <span id="title-holder">&nbsp;</span>
            <div class="links-holder">
                <button type="button" class="basel-back-btn" onClick="history.go(-1);" aria-label="Povratak"><i aria-hidden="true"></i></button><span>&nbsp;</span>
            </div>

    </div>




  <div class="row">

  {{ column_left }}

    {% if column_left and column_right %}
    {% set class = 'col-sm-6' %}
    {% elseif column_left or column_right %}
    {% set class = 'col-md-9 col-sm-8' %}
    {% else %}
    {% set class = 'col-sm-12' %}
    {% endif %}

    <div id="content" class="{{ class }}">
    {{ content_top }}

      <h1 id="page-title">{{ heading_title }}</h1>

      {% if (thumb and category_thumb_status) or (description) %}
        {% if thumb and category_thumb_status %}
        <img class="category-main-thumb" src="{{ thumb }}" alt="{{ heading_title }}" title="{{ heading_title }}" />
        {% endif %}
        {% if description and description != '<p><br></p>' %}
        <div class="category-description"><article>{{ description }}</article></div>
        {% endif %}
      {% endif %}

      {% if categories and category_subs_status %}
      <h2 class="lined-title"><span>{{ text_refine }}</span></h2>
        <style>
        #content .categories.carousel:not(.slick-initialized){height:300px;overflow:hidden;visibility:hidden}
        #content .categories.carousel .item>a:last-child{display:flex;min-height:44px;align-items:center;justify-content:center}
        @media(max-width:767px){
        #content .categories.carousel:not(.slick-initialized){height:calc((100vw - 12px)/2 + 80px)}
        }
        </style>
      	<div class="grid-holder categories carousel grid-holder grid6 prod_module0 carousel">
        	{% for category in categories %}
            <div class="item single-product">
            <a href="{{ category.href }}"><img src="{{ category.thumb }}" width="200" height="200" loading="eager" fetchpriority="low" decoding="async" alt="{{ category.name }}" title="{{ category.name }}" /></a>
            <a href="{{ category.href }}">{{ category.name }}</a></div>
            {% endfor %}
        </div>

          <script>
            $(function() {
              var gkInitCategorySlider = function() {
              if (!$.fn.slick) { setTimeout(gkInitCategorySlider, 50); return; }
              $('.grid-holder.prod_module0').slick({
                  accessibility:false,
                  prevArrow: "<button type=\"button\" class=\"arrow-left\" aria-label=\"Prethodno\"><svg viewBox=\"0 0 24 24\" aria-hidden=\"true\"><path d=\"m15 18-6-6 6-6\"/></svg></button>",
                  nextArrow: "<button type=\"button\" class=\"arrow-right\" aria-label=\"Sljedeće\"><svg viewBox=\"0 0 24 24\" aria-hidden=\"true\"><path d=\"m9 18 6-6-6-6\"/></svg></button>",
                  dots:true,
                  respondTo:'min',
                  rows:1,
                  slidesToShow:5,slidesToScroll:2,responsive:[{breakpoint:960,settings:{slidesToShow:4,slidesToScroll:2}},{breakpoint:600,settings:{slidesToShow:2,slidesToScroll:1}},
                  ]
              });
              $('.product-style2 .single-product .icon').attr('data-placement', 'top');
              $('[data-toggle=\'tooltip\']').tooltip({container: 'body'});
              };
              gkInitCategorySlider();
            });
          </script>
          <style>#content .categories.carousel .item>a:first-child{display:block;aspect-ratio:1/1}#content .categories.carousel .item>a:first-child img{display:block;width:100%;height:100%;object-fit:contain}#content .categories.carousel .slick-arrow{opacity:1!important;color:#111!important;background:rgba(255,255,255,.94)!important;border:1px solid #d8d8d8!important;border-radius:50%}#content .categories.carousel .slick-arrow svg{display:block;width:22px;height:22px;margin:auto;fill:none;stroke:currentColor;stroke-width:1.8;stroke-linecap:round;stroke-linejoin:round}</style>
     {% endif %}

      {% if products %}
      <div id="product-view" class="grid">

      <div class="table filter">

		<div class="table-cell nowrap hidden-sm hidden-md hidden-lg"><button type="button" class="filter-trigger-btn" aria-label="Filter – otvori"></button></div>

          <div class="table-cell nowrap hidden-xs">
          <button type="button" id="grid-view" class="view-icon grid" data-toggle="tooltip" data-title="{{ button_grid }}" aria-label="{{ button_grid }}"><i class="fa fa-th" aria-hidden="true"></i></button>

          </div>

          <div class="table-cell w100">
          <a href="{{ compare }}" id="compare-total" class="hidden-xs">{{ text_compare }}</a>
          </div>

          <div class="table-cell nowrap text-right">
          <div class="sort-select">
          <span class="hidden-xs">{{ text_sort }}</span>
          <select id="input-sort" class="form-control input-sm inline" aria-label="{{ text_sort }}" onchange="location = this.value;">
            {% for sorts in sorts %}
            {% if sorts.value == '%s-%s'|format(sort, order) %}
            <option value="{{ sorts.href }}" selected="selected"> {{ sorts.text }}</option>
            {% else %}
            <option value="{{ sorts.href }}" >{{ sorts.text }}</option>
            {% endif %}
            {% endfor %}
          </select>
          </div>
          </div>

          <div class="table-cell nowrap text-right hidden-xs hidden-sm">
          <span>{{ text_limit }}</span>
          <select id="input-limit" class="form-control input-sm inline" aria-label="{{ text_limit }}" onchange="location = this.value;">
            {% for limits in limits %}
            {% if limits.value == limit %}
            <option value="{{ limits.href }}" selected="selected">{{ limits.text }}</option>
            {% else %}
            <option value="{{ limits.href }}">{{ limits.text }}</option>
            {% endif %}
            {% endfor %}
          </select>
          </div>

      </div>

      <div class="grid-holder product-holder grid{{ basel_prod_grid }}">
        {% for product in products %}
        {% include 'basel/template/product/single_product.twig' %}
        {% endfor %}
      </div>
      </div> <!-- #product-view ends -->

      <div class="row pagination-holder">
        <div class="col-sm-6 xs-text-center pagination-navigation">{{ pagination }}</div>
        <div class="col-sm-6 text-right xs-text-center"><span class="pagination-text">{{ results }}</span></div>
      </div>

      {% endif %}

      {% if not categories and not products %}
      <p>{{ text_empty }}</p>
      {% endif %}

     </div>
    {{ column_right }}</div>
</div>
{{ content_bottom }}
<script>
$(function() {
  var gkInitReadmore = function() {
  if (!$.fn.readmore) { setTimeout(gkInitReadmore, 50); return; }
  $('article').readmore({
    speed: 75,
    collapsedHeight: 40,
    moreLink: '<a href="#">{{ text_more }}</a>',
    lessLink: '<a href="#">{{ text_less }}</a>'
  });
  };
  gkInitReadmore();
});
</script>
{{ footer }}
