<script>
(function() {
  if (window.gkRecaptchaLazyBound) return;
  window.gkRecaptchaLazyBound = true;
  window.gkLoadRecaptcha = function() {
    if (window.gkRecaptchaLoading || window.grecaptcha) return;
    window.gkRecaptchaLoading = true;
    var script = document.createElement('script');
    script.async = true;
    script.defer = true;
    script.src = 'https://www.google.com/recaptcha/api.js?hl={{ lang }}';
    document.head.appendChild(script);
  };
  function needsCaptcha(event) {
    var form = event.target && event.target.closest ? event.target.closest('form') : null;
    if (form && form.querySelector('.g-recaptcha')) window.gkLoadRecaptcha();
  }
  document.addEventListener('focusin', needsCaptcha, true);
  document.addEventListener('pointerdown', needsCaptcha, true);
  window.addEventListener('load', function() {
    var captchas = document.querySelectorAll('.g-recaptcha');
    if (!captchas.length || !('IntersectionObserver' in window)) return;
    var observer = new IntersectionObserver(function(entries) {
      if (entries.some(function(entry) { return entry.isIntersecting; })) {
        observer.disconnect();
        window.gkLoadRecaptcha();
      }
    }, {rootMargin:'300px'});
    Array.prototype.forEach.call(captchas, function(captcha) { observer.observe(captcha); });
  });
})();
</script>

{% if route|slice(0, 9) == 'checkout/' %}

<fieldset>
<legend>{{ text_captcha }}</legend>
<div class="form-group required">
<label class="control-label" for="input-payment-captcha">{{ entry_captcha }}</label>
<div id="input-payment-captcha" class="g-recaptcha" data-sitekey="{{ site_key }}"></div>
{% if error_captcha %}
<div class="text-danger">{{ error_captcha }}</div>
{% endif %}
</div>
</fieldset>

{% elseif (route|slice(0, 12) == 'information/') or (route|slice(0, 8) == 'product/') %}

<div class="required">
<label class="control-label">{{ entry_captcha }}</label>
<div class="g-recaptcha margin-b10" data-sitekey="{{ site_key }}"></div>
{% if error_captcha %}
<div class="text-danger margin-b10">{{ error_captcha }}</div>
{% endif %}
</div>

{% else %}

<fieldset>

<div class="form-group required">

<div class="col-sm-12">
<div class="g-recaptcha" data-sitekey="{{ site_key }}"></div>
{% if error_captcha %}
<div class="text-danger">{{ error_captcha }}</div>
{% endif %}
</div>
</div>
</fieldset>

{% endif %}
