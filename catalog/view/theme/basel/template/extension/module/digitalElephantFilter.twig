{% if is_filter_show %}


<div class="filter-container">

<div class="closemenu mobm filter-mobile-header">
                <strong class="filter-mobile-heading">{{ heading_title }}</strong>
                <div class="icon-element mnu">

                    <button type="button" class="shortcut-wrapper filter-closer hidden-md hidden-lg" aria-label="Zatvori filtre">
                        <i class="icon-line-cross icon" aria-hidden="true"></i>
                    </button>

                      </div>
        </div>


        
    <div id="digitalElephantFilter_box">
        
        <div class="box-content digitalElephantFilter">
            <form id="digitalElephantFilter_form" action="{{ JS_config['action']['getProduct'] }}" method="get">
                {% if filter_data['price']['show'] %}
                    <div class="filter_element_wrap">
                        <div
                            class="filter_element_title"
                            data-section-name="price"
                            data-section-id="price"
                            >
                            {{ text_price_range }}
                        </div>
                        {% set display = 'none' %}
                        {% if filter_data['price']['open'] %}
                            {% set display = 'block' %}
                         {% endif %}
                        <div class="filter_element_content price_slider collapsible" style="display: {{ display }}">
                            
							<input type="hidden" id="digitalElephantFilter_changing_price_min"
                                               value="{{ filter_data['price']['min'] }}" name="price[min]"
                                               class="price">
                            <input type="hidden" id="digitalElephantFilter_changing_price_max"
                                               value="{{ filter_data['price']['max'] }}" name="price[max]"
                                               class="price">

							
                            <div id="slider-range"></div>
							<div class="price-range-holder">
							{{ text_price_range }}
							<b>
							{{ symbol_left }}<span id="price-min-holder">{{ filter_data['price']['min'] }}</span>{{ symbol_right }}
							-
							{{ symbol_left }}<span id="price-max-holder">{{ filter_data['price']['max'] }}</span>{{ symbol_right }}
							</b>
							</div>
                        </div>
                    </div>
                {% endif %}


                {% for package in filter_data['packages'] %}

                    {% for section_group in package %}

                        {% if section_group['sections'] %}

                            {% if is_show_group_attributes and section_group['group_name'] %}
                                <div class="filter_element_title">{{ section_group['group_name'] }}</div>
                            {% endif %}

                            {% for section in section_group['sections'] %}

                                {% if section['type'] and section['values'] %}



                                
                                {% if newURL!='71' and newURL!='72' and newURL!='73' and newURL!='74' and newURL!='75' and newURL!='76' and newURL!='77' and newURL!='78' or section['id'] == 'categories' or section['id'] == 'manufacturer' %}

                                    <div class="filter_element_wrap">

                                        <div
                                            class="filter_element_title {% if is_show_group_attributes and section_group['group_name'] %}is-attribute-child{% endif %}"
                                            data-section-name="{{ section['name'] }}"
                                            data-section-id="{{ section['id'] }}"

                                            data-section-uri="{{ newURL }}"
                                            >{{ section['name'] }}</div>

                                        {% set display = 'none' %}
                                        {% if section['open'] %}
                                            {% set display = 'block' %}
                                        {% endif %}

                                        <div class="filter_element_content" style="display: {{ display }}">

                                            {% set inputs_data = section['values'] %}
                                            {% include "basel/template/extension/module/digitalElephantFilter/%s.twig"|format(section['type']) %}
                                        </div>
                                    </div>

                                 {% endif %}

                                {% endif %}

                            {% endfor %}
                        {% endif %}

                    {% endfor %}

                {% endfor %}
                <div class="digitalElephantFilter_actions">
                    <table width="100%" class="digitalElephantFilter_btn">
                        <tr>
                            {% if is_button_apply and is_button_clear %}
                                <td width="50%" style="padding-right:2px;"><input type="reset" id="digitalElephantFilter_button_clear"
                                                       class="btn btn-outline"
                                                       value="{{ text_clear }}"/></td>
                                <td width="50%" style="padding-left:2px;"><input type="button" id="digitalElephantFilter_button_apply"
                                                       class="btn btn-contrast"
                                                       value="{{ text_ok }}"/></td>
                            {% elseif is_button_apply %}
                                <td width="100%"><input type="button" id="digitalElephantFilter_button_apply"
                                                        class="btn btn-contrast"
                                                        value="{{ text_ok }}"/></td>
                            {% elseif is_button_clear %}
                                <td width="100%"><input type="reset" id="digitalElephantFilter_button_clear"
                                                        class="btn btn-outline"
                                                        value="{{ text_clear }}"/></td>
                            {% endif %}
                        </tr>
                    </table>
                </div>
                            
                <input type="hidden" name="ajax_digitalElephantFilter" value="1"/>
            </form>

            <script>
                var DEFConfig = {
                    peakPrice: {
                        min: '{{ JS_config['peakPrice']['min'] }}',
                        max: '{{ JS_config['peakPrice']['max'] }}'
                    },
                    currentPrice: {
                        min: '{{ JS_config['currentPrice']['min'] }}',
                        max: '{{ JS_config['currentPrice']['max'] }}'
                    },
                    selector: {
                        containerProducts: '{{ JS_config['selector']['containerProducts'] }}',
                        pagination: '{{ JS_config['selector']['pagination'] }}',
                        quantityProducts: '{{ JS_config['selector']['quantityProducts'] }}',
                        limit: '{{ JS_config['selector']['limit'] }}',
                        sort: '{{ JS_config['selector']['sort'] }}'
                    },
                    action: {
                        category: '{{ JS_config['action']['category'] }}',
                        categoryProduct: '{{ JS_config['action']['categoryProduct'] }}',
                        ajaxRenderPagination: '{{ JS_config['action']['ajaxRenderPagination'] }}',
                        ajaxRenderQuantityProducts: '{{ JS_config['action']['ajaxRenderQuantityProducts'] }}',
                        getProduct: '{{ JS_config['action']['getProduct'] }}',
                        ajaxCheckToRenderShowMore: '{{ JS_config['action']['ajaxCheckToRenderShowMore'] }}',
                        ajaxRenderPanel: '{{ JS_config['action']['ajaxRenderPanel'] }}',
                        ajaxSetStateSection: '{{ JS_config['action']['ajaxSetStateSection'] }}'
                    },
                    text: {
                        productNotFound: '{{ JS_config['text']['productNotFound'] }}',
                        buttonShowMore: '{{ JS_config['text']['buttonShowMore'] }}'
                    },
                    categoryPath: '{{ JS_config['categoryPath'] }}',
                    state: {
                        isButtonShowMore: '{{ JS_config['state']['isButtonShowMore'] }}',
                        isPagination: '{{ JS_config['state']['isPagination'] }}',
                        isQuantityProducts: '{{ JS_config['state']['isQuantityProducts'] }}'
                    },
                    isButtonApply: '{{ JS_config['isButtonApply'] }}',
                    preloaderClass: '{{ JS_config['preloaderClass'] }}'
                };
            </script>

            {% if is_ajax_render %}
                <script>
                    $(function(){
                        //instantiation
                        var DEFController = new DigitalElephantFilterController();
                        initSliderPrice(DEFController);
                        //instantiation END
                    });
                </script>
            {% endif %}
        </div>
    </div>
</div>
<style>
@media (max-width: 767px) {
  .filter-container {
    padding-bottom: 0 !important;
    overscroll-behavior: contain;
  }
  iframe[title*="chat"],
  iframe[title*="Chat"],
  iframe[src*="tawk.to"] {
    left: 16px !important;
    right: auto !important;
  }
  html.side-filter-open button.scroll-to-top,
  html.side-filter-open iframe[title*="chat"],
  html.side-filter-open iframe[src*="tawk.to"],
  html.side-filter-open .tawk-min-container,
  html.side-filter-open .cnj-trust-mark-vertical,
  html.side-filter-open .cnj-floating-bar,
  html.side-filter-open .smdWrapperTag {
    display: none !important;
    visibility: hidden !important;
    opacity: 0 !important;
    pointer-events: none !important;
  }
  .filter-mobile-header.closemenu.mobm {
    position: sticky;
    top: 0;
    z-index: 5;
    display: flex !important;
    align-items: center;
    justify-content: space-between;
    width: 100% !important;
    height: 62px !important;
    padding-left: 18px;
    color: #ffffff;
    background: #0054a6;
    box-shadow: 0 1px 0 rgba(0, 0, 0, .12);
  }
  .filter-mobile-heading {
    color: #ffffff;
    font-size: 18px;
    font-weight: 700;
    letter-spacing: .04em;
    text-transform: uppercase;
  }
  .filter-mobile-header .icon-element.mnu {
    position: static !important;
    flex: 0 0 62px;
    width: 62px !important;
    height: 62px !important;
    margin-left: auto;
  }
  .filter-mobile-header .filter-closer,
  .filter-mobile-header .filter-closer:hover,
  .filter-mobile-header .filter-closer:focus {
    width: 62px !important;
    height: 62px !important;
    padding: 0 !important;
    border: 0;
    color: #ffffff !important;
    background: transparent !important;
    outline: 0;
  }
  .filter-mobile-header .filter-closer .icon,
  .filter-mobile-header .filter-closer .icon:before {
    color: #ffffff !important;
    font-size: 24px;
    line-height: 62px;
  }
  #digitalElephantFilter_box {
    padding: 6px 18px 0;
  }
  #digitalElephantFilter_box .filter_element_wrap {
    margin: 0;
    border-bottom: 1px solid #e8e8e8;
  }
  #digitalElephantFilter_box .filter_element_title {
    display: flex;
    align-items: center;
    min-height: 56px;
    padding: 14px 34px 14px 0;
    font-size: 17px;
    line-height: 1.25;
  }
  #digitalElephantFilter_box .filter_element_title:before {
    top: 50%;
    right: 3px;
    transform: translateY(-50%);
  }
  #digitalElephantFilter_box .filter_element_title.is_closed:before {
    transform: translateY(-50%) rotate(-90deg);
  }
  #digitalElephantFilter_box .filter_element_title:after {
    display: none;
  }
  #digitalElephantFilter_box .filter_element_content {
    margin: 0;
    padding: 0 0 14px;
  }
  #digitalElephantFilter_box .filter_element_content:not(.price_slider) {
    max-height: 45vh;
    overflow-y: auto;
    overscroll-behavior: contain;
  }
  #digitalElephantFilter_box .checkbox-inline,
  #digitalElephantFilter_box .radio-inline,
  #digitalElephantFilter_box .digitalElephantFilter_type_checkbox label {
    min-height: 44px;
    padding: 10px 0;
  }
  #digitalElephantFilter_box input[type="checkbox"] + span:before,
  #digitalElephantFilter_box input[type="radio"] + span:before {
    width: 24px;
    height: 24px;
    line-height: 21px;
    margin-right: 10px;
  }
  #digitalElephantFilter_box input[type="checkbox"]:checked + span:before,
  #digitalElephantFilter_box input[type="radio"]:checked + span:before {
    color: #ffffff;
    border-color: #0054a6;
    background: #0054a6;
  }
  #digitalElephantFilter_box .price_slider {
    padding: 10px 4px 20px;
  }
  #digitalElephantFilter_box .digitalElephantFilter_actions {
    position: sticky;
    bottom: 0;
    z-index: 4;
    margin: 18px -18px 0;
    padding: 12px 18px max(12px, env(safe-area-inset-bottom));
    background: #ffffff;
    box-shadow: 0 -6px 16px rgba(0, 0, 0, .08);
  }
  #digitalElephantFilter_box .digitalElephantFilter_actions input.btn {
    min-height: 48px;
    font-size: 14px;
    font-weight: 600;
    text-transform: uppercase;
  }
  #digitalElephantFilter_box .digitalElephantFilter_actions input.btn:disabled {
    color: #888888;
    border-color: #d5d5d5;
    background: #f4f4f4;
    opacity: 1;
  }
}
</style>

<script type="text/javascript">
$(document).ready(function () {
  var pendingDesktopSection = '';
  var lastFilterTrigger = null;

  function isMobileFilter() {
    return window.matchMedia ? window.matchMedia('(max-width: 767px)').matches : $(window).width() < 768;
  }

  function setSectionState($title, open, animate) {
    var $content = $title.next('.filter_element_content');
    if (!$content.length) return;

    $title.toggleClass('is_closed', !open).attr('aria-expanded', open ? 'true' : 'false');
    $content.stop(true, true);

    if (animate) {
      open ? $content.slideDown(180) : $content.slideUp(180);
    } else {
      $content.toggle(open);
    }
  }

  function updateClearButton() {
    var $button = $('#digitalElephantFilter_button_clear');
    if (!$button.length) return;

    var activeCount = $('#digitalElephantFilter_box input[type="checkbox"]:checked, #digitalElephantFilter_box input[type="radio"]:checked').length;
    var currentMin = String((window.DEFConfig && DEFConfig.currentPrice.min) || '');
    var currentMax = String((window.DEFConfig && DEFConfig.currentPrice.max) || '');
    var peakMin = String((window.DEFConfig && DEFConfig.peakPrice.min) || '');
    var peakMax = String((window.DEFConfig && DEFConfig.peakPrice.max) || '');
    var hasPriceFilter = (currentMin && currentMin !== peakMin) || (currentMax && currentMax !== peakMax);
    if (hasPriceFilter) activeCount++;

    $button.val(activeCount ? '{{ text_clear }} (' + activeCount + ')' : '{{ text_clear }}');
    $button.prop('disabled', activeCount === 0);
  }

  function prepareMobileFilter() {
    var $titles = $('#digitalElephantFilter_box .filter_element_title').filter(function () {
      return $(this).next('.filter_element_content').length > 0;
    });

    $titles.attr({ role: 'button', tabindex: '0' });

    if (isMobileFilter()) {
      $titles.each(function () {
        setSectionState($(this), true, false);
      });
    }

    updateClearButton();
  }

  function closeMobileFilter(restoreFocus) {
    $('html').removeClass('no-scroll side-filter-open');
    $('.body-cover').removeClass('active');

    if (window.Tawk_API && typeof window.Tawk_API.showWidget === 'function') {
      window.Tawk_API.showWidget();
    }

    if (restoreFocus && lastFilterTrigger) {
      $(lastFilterTrigger).trigger('focus');
    }
  }

  $('.filter-trigger-btn')
    .addClass('active')
    .attr('aria-label', '{{ heading_title }} – otvori')
    .html('<i class="icon-line-menu icon"></i> <b>{{ heading_title }}</b>');

  $('.filter-trigger-btn').off('click.gkFilterUX').on('click.gkFilterUX', function () {
    lastFilterTrigger = this;
    prepareMobileFilter();
    $('html').addClass('no-scroll side-filter-open');
    $('.body-cover').addClass('active');

    if (window.Tawk_API && typeof window.Tawk_API.hideWidget === 'function') {
      window.Tawk_API.hideWidget();
    }
  });

  $(document)
    .off('click.gkFilterUX', '.filter-closer, .body-cover')
    .on('click.gkFilterUX', '.filter-closer, .body-cover', function (event) {
      event.preventDefault();
      closeMobileFilter(true);
    });

  $(document)
    .off('click.gkFilterUX', '#digitalElephantFilter_button_clear')
    .on('click.gkFilterUX', '#digitalElephantFilter_button_clear', function () {
      closeMobileFilter(false);
    });

  // Replace the extension's generic toggle with one deterministic handler.
  $(document).off('click', '.filter_element_title');
  $(document).on('click.gkFilterUX', '.filter_element_title', function (event) {
    var $title = $(this);
    var $content = $title.next('.filter_element_content');
    if (!$content.length) return;

    event.preventDefault();
    event.stopImmediatePropagation();

    var willOpen = !$content.is(':visible');

    if (isMobileFilter() && willOpen) {
      $('#digitalElephantFilter_box .filter_element_title').not($title).each(function () {
        setSectionState($(this), false, true);
      });
    }

    setSectionState($title, willOpen, true);

    if (!isMobileFilter() && window.DEFConfig && DEFConfig.action && DEFConfig.action.ajaxSetStateSection) {
      $.post(DEFConfig.action.ajaxSetStateSection, {
        section: {
          state: willOpen ? 1 : 0,
          name: $title.attr('data-section-name'),
          id: $title.attr('data-section-id')
        }
      });
    }
  });

  $(document)
    .off('keydown.gkFilterUX', '.filter_element_title')
    .on('keydown.gkFilterUX', '.filter_element_title', function (event) {
      if (event.key === 'Enter' || event.key === ' ') {
        event.preventDefault();
        $(this).trigger('click');
      }
    });

  $(document)
    .off('change.gkFilterUX', '#digitalElephantFilter_box input[type="checkbox"], #digitalElephantFilter_box input[type="radio"]')
    .on('change.gkFilterUX', '#digitalElephantFilter_box input[type="checkbox"], #digitalElephantFilter_box input[type="radio"]', function () {
      pendingDesktopSection = $(this).closest('.filter_element_wrap').find('.filter_element_title').attr('data-section-id') || '';
      updateClearButton();
    });

  $(document).off('keydown.gkFilterEscape').on('keydown.gkFilterEscape', function (event) {
    if (event.key === 'Escape' && $('html').hasClass('side-filter-open')) {
      closeMobileFilter(true);
    }
  });

  $(document).off('ajaxComplete.gkFilterUX').on('ajaxComplete.gkFilterUX', function (event, xhr, settings) {
    try {
      var url = String(settings.url || '');
      var success = xhr.status >= 200 && xhr.status < 300;
      var isProductRefresh = url.indexOf(DEFConfig.action.getProduct) !== -1;
      var isPanelRefresh = url.indexOf(DEFConfig.action.ajaxRenderPanel) !== -1;

      if (success && isMobileFilter() && isProductRefresh && $('html').hasClass('side-filter-open')) {
        closeMobileFilter(false);
      }

      if (success && isPanelRefresh) {
        requestAnimationFrame(function () {
          if (isMobileFilter()) {
            prepareMobileFilter();
          } else if (pendingDesktopSection) {
            var $title = $('.filter_element_title[data-section-id="' + pendingDesktopSection + '"]');
            if ($title.length) setSectionState($title, true, false);
            pendingDesktopSection = '';
            updateClearButton();
          }
        });
      }
    } catch (error) {}
  });

  prepareMobileFilter();
});
</script>


{% endif %}
