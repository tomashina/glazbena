<div class="newsletter-wrap">
<div class="input-group sign-up-field">

<input type="text" id="subscribe-module{{ module }}" name="email" class="form-control" placeholder="{{ basel_subscribe_email }}" />
<span class="input-group-btn" style="min-width: 40px;padding:0px;">
<a class=" nowrap" onclick="subscribe({{ module }});"><img src="image/buttonn.png" style="margin-left:5px"/></a>
</span>
</div>
<p  style="margin:10px 0"><input class="chk" name="terms" required type="checkbox"> <a href="https://www.glazbena-kutija.hr/opci-uvjeti" target="_blank">{{ basel_accept_terms }} </a></p>
</div>
<span class="sign-up-respond" id="subscribe-respond{{ module }}" style="margin-top: 5px;display: block;color: red;"></span>