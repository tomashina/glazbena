{% if fullwidth %}
</div>
{% endif %}
<div class="widget" style="margin-bottom:{{ margin_bottom }};">
	<div class="col-sm-8">
<div id="masterslider{{ module }}" class="master-slider widget {{ nav_buttons }}" style="min-height:{{ height }}px">
{% for section in sections %}
{% if section.sort_order > 0 %}
<div class="ms-slide {% if section.slide_kenburn is defined %} kenburn {{ section.slide_kenburn }}{% endif %}" data-delay="{{ section.duration }}" {% if section.bg_color|length %} style="background-color:{{ section.bg_color }}"{% endif %}>
{% if section.is_bg %}
<picture class="gk-slide-picture">
{% if section.mobile_image %}<source media="(max-width: 767px)" srcset="{{ section.mobile_image }}">{% endif %}
<img src="{{ section.thumb_image }}" data-src="{{ section.thumb_image }}" class="slide-bg" alt="">
</picture>
{% endif %}
{% for key, group in section.groups %}
{% if group.type == 'text' %}
<!-- Text layer -->
    <div class="ms-layer ms-caption" style="font-family:{{ group.font }};font-weight:{{ group.fontweight }};font-size:{{ group.fontsize }};color:{{ group.color }};{% if group.bg|length %}background-color:{{ group.bg }}{% endif %};padding:{{ group.padding }};border-radius:{{ group.radius }};white-space:nowrap; {{ group.customcss }};"
    data-origin = "ml" data-type = "text" data-offset-x = "{{ group.left }}" data-offset-y = "{{ group.top }}" data-parallax = "{{ group.p_index }}" data-duration = "{{ group.durationin }}" data-delay = "{{ group.start }}" data-effect = "{{ group.transitionin }}" data-ease = "{{ group.easingin }}" data-hide-effect = "{{ group.transitionout }}" data-hide-duration = "{{ group.durationout }}" data-hide-ease = "{{ group.easingout }}" data-hide-time = "{{ group.end }}" > {{ group.description }}
    </div>
{% endif %}
{% if group.type == 'image' %}
<!-- Image layer -->
    <img src="{{ group.image }}" alt="" data-src="{{ group.image }}" class="ms-layer image"
    {% if group.minheight is defined %} style="min-height:{{ group.minheight }}px" {% endif %}
    data-origin = "ml" data-type = "image" data-offset-x = "{{ group.left }}" data-offset-y = "{{ group.top }}" data-parallax = "{{ group.p_index }}" data-duration = "{{ group.durationin }}" data-delay = "{{ group.start }}" data-effect = "{{ group.transitionin }}" data-ease = "{{ group.easingin }}" data-hide-effect = "{{ group.transitionout }}" data-hide-duration = "{{ group.durationout }}" data-hide-ease = "{{ group.easingout }}" data-hide-time = "{{ group.end }}" />
{% endif %}
{% if group.type == 'button' %}
<!-- Button layer -->
    <a class="ms-layer ms-btn {{ group.button_class }}{% if group.button_target %} external{% endif %}" href="{{ group.button_href }}" style="white-space:nowrap;"
    data-origin = "ml" data-type = "button" data-offset-x = "{{ group.left }}" data-offset-y = "{{ group.top }}" data-parallax = "{{ group.p_index }}" data-duration = "{{ group.durationin }}" data-delay = "{{ group.start }}" data-effect = "{{ group.transitionin }}" data-ease = "{{ group.easingin }}" data-hide-effect = "{{ group.transitionout }}" data-hide-duration = "{{ group.durationout }}" data-hide-ease = "{{ group.easingout }}" data-hide-time = "{{ group.end }}" >
    <span>{{ group.description }}</span></a>
{% endif %}
{% endfor %}<!-- foreach groups -->
{% if section.link %}
<a href="{{ section.link }}" class="ls-link {% if section.link_new_window %} external{% endif %}"></a>
{% endif %}
</div><!-- .ls-slide ends -->
{% endif %}
{% endfor %}<!-- foreach sections ends -->
</div><!-- id masterslider ends -->

</div>
<div class="col-sm-4 xstop hidden-xs">

    {% for banner in banners|slice(0, 1) %}
        {% if banner.link %}<a href="{{ banner.link }}"><img src="{{ banner.image }}" alt="{{ banner.title }}"  /></a>{% else %}<img src="{{ banner.image }}" alt="{{ banner.title }}"  />{% endif %}
    {% endfor %}
</div>
    <div class="col-sm-4 xstop visible-xs">

        {% for banner in banners|slice(1, 2) %}
            {% if banner.link %}<a href="{{ banner.link }}"><img src="{{ banner.image }}" alt="{{ banner.title }}"  /></a>{% else %}<img src="{{ banner.image }}" alt="{{ banner.title }}"  />{% endif %}
        {% endfor %}
    </div>
<div class="clearfix"></div>
</div><!-- .widget -->
<style>
@media(max-width:767px){
#masterslider{{ module }} .gk-slide-picture img{width:100%;height:100%;object-fit:cover}
#masterslider{{ module }} .ms-caption{max-width:86vw!important;white-space:normal!important;line-height:1.2!important;text-align:center}
#masterslider{{ module }}{overflow:visible!important;margin-bottom:34px!important}
#masterslider{{ module }} .ms-bullets.ms-dir-h{bottom:-25px!important;height:12px!important}
#masterslider{{ module }} .ms-bullet{width:9px!important;height:9px!important;margin:0 5px!important;border:0!important;border-radius:50%!important;background:#d6d8db!important}
#masterslider{{ module }} .ms-bullet-selected{background:#171717!important}
}
</style>
<script>
$(document).ready(function(){
var slider = new MasterSlider();
var gkMobileSlider = window.matchMedia && window.matchMedia('(max-width: 767px)').matches;
slider.setup('masterslider{{ module }}' , {
	width:{{ width }},
	height:gkMobileSlider ? {{ width }} : {{ height }},
	minHeight:gkMobileSlider ? 0 : {{ minheight }},
	layout:"fillwidth",
	grabCursor:false,
	centerControls:false,
	autoplay:true,
	hideLayers:true,
	instantStartLayers:true,
	overPause:false,
	{% if loop %}loop:true,{% endif %}
	speed:{{ speed }},
	view:"{{ slide_transition }}"
});
{% if nav_buttons %}slider.control('arrows' , {autohide:false});{% endif %}
{% if nav_bullets %}slider.control('bullets' , {autohide:false});{% endif %}
{% if nav_timer_bar %}slider.control('timebar' , {width:5});{% endif %}
setTimeout("$('body').addClass('ms_ready');", 400);
});
</script>
{% if fullwidth %}
<div class="container">
{% endif %}
