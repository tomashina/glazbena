<div class="widget module{{ module }} {% if columns != 'list' %} grid{% endif %}{% if contrast %} contrast-bg{% endif %}{% if carousel and rows > 1 %}  multiple-rows{% endif %}" {% if use_margin %}style="margin-bottom: {{ margin }}"{% endif %}>
{% if block_title %}
<!-- Block Title -->
<div class="widget-title">
{% if title_preline %}<p class="pre-line">{{ title_preline }}</p>{% endif %}
{% if title %}
<p class="main-title"><span>{{ title }}</span></p>
<p class="widget-title-separator"><i class="icon-line-cross"></i></p>
{% endif %}
{% if title_subline %}
<p class="sub-line"><span>{{ title_subline }}</span></p>
{% endif %}
</div>
{% endif %}
{% if tabs|length > 1 %}
<!-- Tabs -->
<ul id="tabs-{{ module }}" class="nav nav-tabs {{ tabstyle }}" data-tabs="tabs" style="">
    {% for keyTab, tab in tabs %}
        {% if keyTab == 0 %}
        <li class="active"><a href="#tab{{ module }}{{ keyTab }}" data-toggle="tab">{{ tab.title }}</a></li>
        {% else %}
        <li><a href="#tab{{ module }}{{ keyTab }}" data-toggle="tab">{{ tab.title }}</a></li>
        {% endif %}
    {% endfor %}
</ul>
{% endif %}
<div class="tab-content has-carousel {% if not carousel %}overflow-hidden{% endif %}">
<!-- Product Group(s) -->
{% for key, tab in tabs %}
<div class="tab-pane{% if key == 0 %} active in{% endif %} fade" id="tab{{ module }}{{ key }}">
    <div class="grid-holder grid{{ columns }} prod_module{{ module }}{% if carousel %} carousel{% endif %}{% if carousel_a and rows > 1 %} sticky-arrows{% endif %}">
        {% for product in tab.products %}
            <div class="item single-product">
            <div class="image"{% if columns == 'list' %} style="width:{{ img_width }}px"{% endif %}>
                <a href="{{ product.href }}">
                {% if product.thumb2 %}
                <img class="thumb1" src="{{ product.thumb }}" loading="lazy" width="400" height="400" alt="{{ product.name }}" title="{{ product.name }}" />
                <img class="thumb2" src="{{ product.thumb2 }}" loading="lazy" width="400" height="400" alt="{{ product.name }}" title="{{ product.name }}" />
                {% else %}
                <img src="{{ product.thumb }}" loading="lazy" width="400" height="400" alt="{{ product.name }}" title="{{ product.name }}" />
                {% endif %}
                </a>
            {% if product.price and product.special and product.sale_badge %}
                <div class="sale-counter id{{ product.product_id }}"></div>
				 <a  href="{{ product.href }}"> <span class="badge sale_badge"><i>{{ product.sale_badge }}</i></span></a>
            {% endif %}
            {% if product.new_label %}
  <a  href="{{ product.href }}">  <span class="badge novo_badge{% if lang =='en'%}en{% endif %}"></span></a>
{% endif %}



{% if product.jan %}
 <a  href="{{ product.href }}">   <span class="badge hot_badge"></span></a>
{% endif %}
			{% if ((product.quantity < 1) and (stock_badge_status)) %}
			<!--	<span class="badge out_of_stock_badge"><i>{{ basel_text_out_of_stock }}</i></span>-->
				{% set button_cart = basel_text_out_of_stock %}
			{% else %}
				{% set button_cart = default_button_cart %}
			{% endif %}
            <a class="img-overlay" href="{{ product.href }}"></a>
            <div class="btn-center catalog_hide"><a class="btn btn-light-outline btn-thin" onclick="cart.add('{{ product.product_id }}', '{{ product.minimum }}');">{{ button_cart }}</a></div>
            </div><!-- .image ends -->
               {% if product.rating %}
                <div class="rating">
                 <i data-star="{{ product.rating }}"></i>
                </div>
            {% endif %}
            <div class="caption">
                <span class="pcatname">{{ product.category }}</span>
            <a class="product-name" href="{{ product.href }}">{{ product.name }}</a>
         
            <div class="price-wrapper">
            {% if product.price %}
            <div class="price">
                {% if not product.special %}
                <span>{{ product.price }}</span>
                {% else %}
              {% if ( product.price_last_30  >  product.special and  product.price_last_30  <  product.price  ) %}
                                                <span class="price-old">{{ basel_30 }} {{ product.price_last_30 }}</span>
                                                {% else %}
                                                    <span class="price-old">{{ basel_30 }} {{ product.price }}</span>
                                                {% endif %}
                                                <span class="price-new">{{ product.special }}</span>
                {% endif %}
                {% if product.tax %}
                <span class="price-tax">{{ text_tax }} {{ product.tax }}</span>
                {% endif %}
            </div><!-- .price -->
            {% endif %}

                {% if ((product.quantity < 1) and (stock_badge_status)) %}
                    
   <span class="outofstock" {% if product.stock_id=='5' %}style="color:red" {% endif %} {% if product.stock_id=='8' %}style="color:orange" {% endif %}>{{ product.stock }}</span>
                {% else %}
                    <span class="instock">
                        {% if product.quantity > 0 and  product.quantity < 16 %}
                                {{ product.quantity }} {{ basel_text_instock }}
                             {% else %}
                             15+  {{ basel_text_instock }}
                             {% endif %}
                    </span>
                {% endif %}
            <p class="description">{% if product.description %}{{ product.description }}{% endif %}</p>
                {% if ((product.quantity < 1) and (stock_badge_status)) %}
                    <a href="{{ product.href }}" class="btn catalog_hide {% if basel_list_style == '6' %}btn-contrast outofstock {% else %}btn-outline{% endif %}" ><span class="ikona"></span><img src="image/upit-black.svg" class="carticon">{{ basel_text_upit }}</a>
                {% else %}
                    <a class="btn catalog_hide {% if basel_list_style == '6' %}btn-contrast {% else %}btn-outline{% endif %}" onclick="cart.add('{{ product.product_id }}', '{{ product.minimum }}');"><span class="car"></span><img src="image/kosarica-white.svg" class="carticon">{{ button_cart }}</a>
                {% endif %}
            </div>
            </div><!-- .caption-->
            {% if product.sale_end_date and countdown_status %}
            <script>
			  $(function() {
				$(".module{{ module }} .sale-counter.id{{ product.product_id }}").countdown("{{ product.sale_end_date }}").on('update.countdown', function(event) {
			  var $this = $(this).html(event.strftime(''
				+ '<div>'
				+ '%D<i>{{ basel_text_days }}</i></div><div>'
				+ '%H <i>{{ basel_text_hours }}</i></div><div>'
				+ '%M <i>{{ basel_text_mins }}</i></div><div>'
				+ '%S <i>{{ basel_text_secs }}</i></div></div>'));
			});
			  });
			</script>
            {% endif %}
            </div><!-- .single-product ends -->
        {% endfor %}
    </div>
</div>
{% endfor %}
{% if use_button %}
<!-- Button -->
<div class="widget_bottom_btn {% if carousel and carousel_b %}has-dots{% endif %}">
<a class="btn btn-contrast" href="{{ link_href ? link_href : '' }}">{{ link_title }}</a>
</div>
{% endif %}
</div>
<div class="clearfix"></div>
</div>
{% if carousel %}
<script>
$('.grid-holder.prod_module{{ module }}').slick({
{% if carousel_a %}
prevArrow: "<a class=\"arrow-left icon-arrow-left\"></a>",
nextArrow: "<a class=\"arrow-right icon-arrow-right\"></a>",
{% else %}
arrows: false,
{% endif %}
{% if direction == 'rtl' %}
rtl: true,
{% endif %}
{% if carousel_b %}
dots:true,
{% endif %}
respondTo:'min',
rows:{{ rows }},
{% if columns == '5' %}
slidesToShow:5,slidesToScroll:5,responsive:[{breakpoint:1100,settings:{slidesToShow:4,slidesToScroll:4}},{breakpoint:960,settings:{slidesToShow:3,slidesToScroll:3}},{breakpoint:600,settings:{slidesToShow:2,slidesToScroll:2}},
{% elseif columns == '4' %}
slidesToShow:4,slidesToScroll:4,responsive:[{breakpoint:960,settings:{slidesToShow:3,slidesToScroll:3}},{breakpoint:600,settings:{slidesToShow:2,slidesToScroll:2}},
{% elseif columns == '3' %}
slidesToShow:3,slidesToScroll:3,responsive:[{breakpoint:600,settings:{slidesToShow:2,slidesToScroll:2}},
{% elseif columns == '2' %}
slidesToShow:2,slidesToScroll:2,responsive:[
{% elseif columns == '1' or columns == 'list' %}
adaptiveHeight:true,slidesToShow:1,slidesToScroll:1,responsive:[
{% endif %}
{% if items_mobile_fw %}
{breakpoint:420,settings:{slidesToShow:1,slidesToScroll:1}}
{% endif %}
]
});
$('.product-style2 .single-product .icon').attr('data-placement', 'top');
$('[data-toggle=\'tooltip\']').tooltip({container: 'body'});
{% if carousel_a and rows > 1 %}
$(window).load(function() {
var p_c_o = $('.prod_module{{ module }}').offset().top;
var p_c_o_b = $('.prod_module{{ module }}').offset().top + $('.prod_module{{ module }}').outerHeight(true) - 100;
var p_sticky_arrows = function(){
var p_m_o = $(window).scrollTop() + ($(window).height()/2);
if (p_m_o > p_c_o && p_m_o < p_c_o_b) {
$('.prod_module{{ module }} .slick-arrow').addClass('visible').css('top', p_m_o - p_c_o + 'px');
} else {
$('.prod_module{{ module }} .slick-arrow').removeClass('visible');
}
};
$(window).scroll(function() {p_sticky_arrows();});
});
{% endif %}
</script>
{% endif %}
