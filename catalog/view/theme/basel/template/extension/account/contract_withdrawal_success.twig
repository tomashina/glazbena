{{ header }}
<div class="container">
  <ul class="breadcrumb">{% for breadcrumb in breadcrumbs %}<li><a href="{{ breadcrumb.href }}">{{ breadcrumb.text }}</a></li>{% endfor %}</ul>
  <div class="row">
    {{ column_left }}
    {% if column_left and column_right %}{% set class = 'col-sm-6' %}{% elseif column_left or column_right %}{% set class = 'col-md-9 col-sm-8' %}{% else %}{% set class = 'col-sm-12' %}{% endif %}
    <div id="content" class="{{ class }}">
      {{ content_top }}
      <h1 id="page-title">{{ text_success_title }}</h1>
      <div class="alert alert-success"><i class="fa fa-check-circle"></i> {{ text_success_message }}</div>
      <div class="table-responsive"><table class="table table-bordered"><tbody><tr><td><b>{{ text_reference }}</b></td><td>#{{ contract_withdrawal_id }}</td></tr><tr><td><b>{{ entry_order_id }}</b></td><td>#{{ order_id }}</td></tr><tr><td><b>{{ entry_email }}</b></td><td>{{ email }}</td></tr><tr><td><b>{{ text_submitted }}</b></td><td>{{ date_submitted }}</td></tr><tr><td><b>{{ text_status }}</b></td><td>{{ status }}</td></tr></tbody></table></div>
      <h3 class="lined-title"><span><b>{{ text_statement }}</b></span></h3>
      <pre style="white-space:pre-wrap;padding:18px;border:1px solid #ddd;background:#f7f7f7;font-family:inherit;line-height:1.6">{{ statement }}</pre>
      <div class="buttons clearfix margin-b50"><div class="pull-left"><a href="{{ account }}" class="btn btn-default">{{ text_back_account }}</a></div><div class="pull-right"><a href="{{ continue }}" class="btn btn-contrast">{{ text_continue }}</a></div></div>
    </div>
    {{ column_right }}
  </div>
</div>
{{ content_bottom }}
{{ footer }}
