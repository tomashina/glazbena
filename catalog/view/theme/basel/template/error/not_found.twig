{{ header }}
<style>
.gk-not-found{padding:28px 0 56px;background:linear-gradient(180deg,#f7f8fa 0,#fff 62%);color:#252525}.gk-not-found *{box-sizing:border-box}.gk-not-found__hero{max-width:780px;margin:0 auto;text-align:center}.gk-not-found__code{margin:0;color:#0966b3;font-size:clamp(76px,10vw,126px);font-weight:700;line-height:.92;letter-spacing:-.06em}.gk-not-found__eyebrow{margin:12px 0 8px;color:#0966b3;font-size:12px;font-weight:700;letter-spacing:.16em;text-transform:uppercase}.gk-not-found__eyebrow i{margin-right:7px}.gk-not-found h1{margin:0 0 10px;font-size:clamp(27px,3vw,38px);font-weight:500;line-height:1.15}.gk-not-found__lead{max-width:620px;margin:0 auto 22px;color:#666;font-size:16px;line-height:1.6}.gk-not-found__search{max-width:660px;margin:0 auto 10px}.gk-not-found__search-label{display:block;margin:0 0 8px;font-size:17px;font-weight:600}.gk-not-found__search-row{display:flex;background:#fff;border:1px solid #d9dde2;border-radius:4px;box-shadow:0 10px 28px rgba(26,48,70,.09);overflow:hidden}.gk-not-found__search input{min-width:0;flex:1;height:52px;padding:0 18px;border:0;background:transparent;font-size:15px;outline:0}.gk-not-found__search button{display:inline-flex;align-items:center;justify-content:center;gap:9px;min-width:138px;border:0;background:#0966b3;color:#fff;font-weight:600;text-transform:uppercase;transition:background .2s}.gk-not-found__search button:hover,.gk-not-found__search button:focus{background:#074f8b}.gk-not-found__path{margin:0;color:#9299a1;font-size:12px;overflow-wrap:anywhere}.gk-not-found__quick{margin-top:34px}.gk-not-found__quick h2,.gk-not-found__categories h2{margin:0 0 16px;text-align:center;font-size:21px;font-weight:500}.gk-not-found__grid{display:grid;grid-template-columns:repeat(4,1fr);gap:12px}.gk-not-found__card{display:flex;align-items:center;gap:12px;min-height:82px;padding:16px;border:1px solid #e1e4e8;background:#fff;color:#222;transition:border-color .2s,box-shadow .2s,transform .2s}.gk-not-found__card:hover,.gk-not-found__card:focus{border-color:#0966b3;box-shadow:0 10px 24px rgba(26,48,70,.09);transform:translateY(-2px);color:#0966b3}.gk-not-found__icon{display:flex;align-items:center;justify-content:center;flex:0 0 38px;width:38px;height:38px;border-radius:50%;background:#edf5fb;color:#0966b3;font-size:16px}.gk-not-found__card strong,.gk-not-found__card small{display:block}.gk-not-found__card strong{margin-bottom:3px;font-size:14px}.gk-not-found__card small{color:#777;line-height:1.3}.gk-not-found__categories{margin-top:28px;padding-top:26px;border-top:1px solid #eceef0}.gk-not-found__pills{display:flex;flex-wrap:wrap;justify-content:center;gap:8px}.gk-not-found__pill{padding:9px 15px;border:1px solid #d9dde2;border-radius:999px;background:#fff;color:#333;font-size:13px}.gk-not-found__pill:hover,.gk-not-found__pill:focus{border-color:#0966b3;background:#edf5fb;color:#0966b3}@media(max-width:767px){.gk-not-found{padding:22px 0 42px}.gk-not-found__lead{font-size:15px}.gk-not-found__search-row{display:block;border:0;background:transparent;box-shadow:none;overflow:visible}.gk-not-found__search input{width:100%;height:50px;border:1px solid #d9dde2;background:#fff;box-shadow:0 8px 20px rgba(26,48,70,.08)}.gk-not-found__search button{width:100%;height:48px;margin-top:8px}.gk-not-found__grid{grid-template-columns:1fr 1fr}.gk-not-found__card{align-items:flex-start;min-height:116px;flex-direction:column}.gk-not-found__quick{margin-top:30px}}@media(max-width:420px){.gk-not-found__grid{grid-template-columns:1fr}.gk-not-found__card{min-height:0;flex-direction:row;align-items:center}}
</style>
<main id="content" class="gk-not-found">
  <div class="container">
    <section class="gk-not-found__hero" aria-labelledby="not-found-title">
      <div class="gk-not-found__code" aria-hidden="true">404</div>
      <p class="gk-not-found__eyebrow"><i class="fa fa-music" aria-hidden="true"></i>{{ text_eyebrow|default('Ups, pogrešan ton') }}</p>
      <h1 id="not-found-title">{{ heading_title }}</h1>
      <p class="gk-not-found__lead">{{ text_error }}</p>
      <form class="gk-not-found__search" action="{{ search_action|default('index.php') }}" method="get" role="search">
        <input type="hidden" name="route" value="product/search" />
        <label class="gk-not-found__search-label" for="not-found-search">{{ text_search_title|default('Što tražite?') }}</label>
        <div class="gk-not-found__search-row">
          <input id="not-found-search" type="search" name="search" placeholder="{{ text_search_placeholder|default('Upišite naziv proizvoda, brenda ili šifru') }}" autocomplete="off" required />
          <button type="submit"><i class="fa fa-search" aria-hidden="true"></i> {{ text_search_button|default('Pretraži') }}</button>
        </div>
      </form>
      {% if requested_path %}<p class="gk-not-found__path">{{ text_requested_path|default('Tražena adresa:') }} {{ requested_path }}</p>{% endif %}
    </section>

    <section class="gk-not-found__quick" aria-labelledby="quick-links-title">
      <h2 id="quick-links-title">{{ text_quick_links|default('Možda ste tražili') }}</h2>
      <div class="gk-not-found__grid">
        <a class="gk-not-found__card" href="{{ continue|default('/') }}"><span class="gk-not-found__icon"><i class="fa fa-home" aria-hidden="true"></i></span><span><strong>{{ text_home_link|default('Početna stranica') }}</strong><small>{{ text_home_help|default('Vratite se na početak') }}</small></span></a>
        <a class="gk-not-found__card" href="{{ special|default('special') }}"><span class="gk-not-found__icon"><i class="fa fa-percent" aria-hidden="true"></i></span><span><strong>{{ text_special_link|default('Akcije') }}</strong><small>{{ text_special_help|default('Aktualne snižene cijene') }}</small></span></a>
        <a class="gk-not-found__card" href="{{ brands|default('index.php?route=product/manufacturer') }}"><span class="gk-not-found__icon"><i class="fa fa-tags" aria-hidden="true"></i></span><span><strong>{{ text_brands_link|default('Brendovi') }}</strong><small>{{ text_brands_help|default('Pregled svih proizvođača') }}</small></span></a>
        <a class="gk-not-found__card" href="{{ contact|default('index.php?route=information/contact') }}"><span class="gk-not-found__icon"><i class="fa fa-comments-o" aria-hidden="true"></i></span><span><strong>{{ text_contact_link|default('Trebate pomoć?') }}</strong><small>{{ text_contact_help|default('Javite nam što tražite') }}</small></span></a>
      </div>
    </section>

    {% if popular_categories %}
    <nav class="gk-not-found__categories" aria-labelledby="popular-categories-title">
      <h2 id="popular-categories-title">{{ text_categories|default('Popularne kategorije') }}</h2>
      <div class="gk-not-found__pills">
        {% for category in popular_categories %}<a class="gk-not-found__pill" href="{{ category.href }}">{{ category.name }}</a>{% endfor %}
      </div>
    </nav>
    {% endif %}
  </div>
</main>
{{ content_bottom }}
{{ footer }}
