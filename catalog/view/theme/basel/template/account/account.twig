{{ header }}
<div class="container">
  <ul class="breadcrumb">
    {% for breadcrumb in breadcrumbs %}
    <li><a href="{{ breadcrumb.href }}">{{ breadcrumb.text }}</a></li>
    {% endfor %}
  </ul>
    <!-- breadcrumb -->
    <div class="breadcrumb-holder">

            <span id="title-holder">&nbsp;</span>
            <div class="links-holder">
                <a class="basel-back-btn" onClick="history.go(-1); return false;"><i></i></a><span>&nbsp;</span>
            </div>
       
    </div>
  {% if success %}
  <div class="alert alert-success"><i class="fa fa-check-circle"></i> {{ success }}</div>
  {% endif %}
  <div class="row">{{ column_left }}
    {% if column_left and column_right %}
    {% set class = 'col-sm-6' %}
    {% elseif column_left or column_right %}
    {% set class = 'col-md-9 col-sm-8' %}
    {% else %}
    {% set class = 'col-sm-12' %}
    {% endif %}
    <div id="content" class="{{ class }}">{{ content_top }}
    <h1 id="page-title">{{ text_my_account }}</h1>
      <legend>{{ text_my_account }}</legend>
      <ul class="list-unstyled margin-b30">
        <li><a href="{{ edit }}">{{ text_edit }}</a></li>
        <li><a href="{{ password }}">{{ text_password }}</a></li>
        <li><a href="{{ address }}">{{ text_address }}</a></li>
        <li><a href="{{ wishlist }}">{{ text_wishlist }}</a></li>
      </ul>
      {% if credit_cards %}
      <h2>{{ text_credit_card }}</h2>
      <ul class="list-unstyled">
        {% for credit_card in credit_cards %}
        <li><a href="{{ credit_card.href }}">{{ credit_card.name }}</a></li>
        {% endfor %}
      </ul>
      {% endif %}
      <legend>{{ text_my_orders }}</legend>
      <ul class="list-unstyled margin-b30">
        <li><a href="{{ order }}">{{ text_order }}</a></li>

        {% if reward %}
        <li><a href="{{ reward }}">{{ text_reward }}</a></li>
        {% endif %}
        <li><a href="{{ return }}">{{ text_return }}</a></li>
        <li><a href="{{ contract_withdrawal }}">Raskid ugovora</a></li>

      </ul>



      <legend>{{ text_my_newsletter }}</legend>
      <ul class="list-unstyled margin-b30">
        <li><a href="{{ newsletter }}">{{ text_newsletter }}</a></li>
      </ul>

      <legend>{{ text_logout }}</legend>
      <ul class="list-unstyled margin-b30">
        <li><a href="{{ logout }}">{{ text_logout }}</a></li>
      </ul>
      </div>
    {{ column_right }}</div>
</div>
{{ content_bottom }}
{{ footer }}
