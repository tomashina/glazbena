{{ header }}
<div id="product-category" class="container">
  <ul class="breadcrumb">
    {% for breadcrumb in breadcrumbs %}
    <li><a href="{{ breadcrumb.href }}">{{ breadcrumb.text }}</a></li>
    {% endfor %}
  </ul>

      <!-- breadcrumb -->
    <div class="breadcrumb-holder">

      <span id="title-holder">&nbsp;</span>
      <div class="links-holder">
      <a class="basel-back-btn" onClick="history.go(-1); return false;"><i></i></a><span>&nbsp;</span>
      </div>

    </div>

  <div class="row">{{ column_left }}
    {% if column_left and column_right %}
    {% set class = 'col-sm-6' %}
    {% elseif column_left or column_right %}
    {% set class = 'col-sm-9' %}
    {% else %}
    {% set class = 'col-sm-12' %}
    {% endif %}
    <div id="content" class="{{ class }}" style="margin-top:20px">{{ content_top }}
     <h1 id="page-title">{{ heading_title }}</h1>


          <div class="" id="main-panel">


 
      
      {% if categorybundles %}
      {% for result in categorybundles %}
          <form action="" method="post" enctype="multipart/form-data" class="tmdcartbundle{{ result.bundle_id }}">
          <input type="hidden" name="bundle_id" value="{{ result.bundle_id }}"/>
          <div class="panel panel-default panel-glazbena">
        
            <div class="panel-body" style="padding-bottom:0px;padding-top:0px">
                <div class="row grid-holder product-holder grid4 " style="margin:0px">
                {% for product in result.product_infos %}
                  <div class="item single-product">
                      <input type="hidden" name="bundleproduct[{{ product.product_id }}][product_id]" value="{{ product.product_id }}" />
                      <input type="hidden" name="bundleproduct[{{ product.product_id }}][quantity]" value="{{ product.minimum }}" />
                       
              
                          <div class="image">
                            <a href="{{ product.href }}">
                            <img src="{{ product.image }}" alt="{{ product.name }}" title="{{ product.name }}" class="bundle-thumb"/></a>
                           
                                       
                          </div>
                         <div class="caption">
                           <a class="product-name" href="{{ product.href }}">{{ product.name }}</a>
                        
                          
                     
                         
                                         <div class="price-wrapper">

                                      <div class="price">
                                    <span>{{ product.price }} x {{ product.minimum }}</span>

                                        </div>
                                </div>
                                   

                        </div>
                      </div>
                 {% endfor %}
                 
               </div>

                {% if result.newprice %}
                         <div class="holdprice" style="border-top: 10px solid #f5f5f5;margin: 10px 0px;">
                         
                      
                            <div class="col-md-3"><span class="bundle_discount">{{ text_regularprice }}: <span class="text-red" style="text-decoration: line-through;">{{ result['total'] }}</span></span>  </div>

                     <div class="col-md-3"><span class="bundle_discount">{{ text_price }}: <strong class="text-green">{{ result['newprice'] }}</strong></span>  </div>

                      <div class="col-md-3"><span class="bundle_discount">{{ text_save }}: <strong class="text-blue">{{ result['discount'] }}</strong></span>  </div>
                                  
                       


                       <div class="col-md-3">
                            <button type="button"  style="margin: 10px 0;width:100%"  rel="{{ result.bundle_id }}" class="btn  btn-primary bundle-cart addloading{{ result.bundle_id }}" ><span class="car"></span><img src="image/kosarica-white.svg" class="carticon"><span>{{ button_addtocart }}</span></button>
                          </div>


                      </div>
                   
                  {% endif %}



            </div>
          </div>
        </form>
       {% endfor %}
       <div class="row">
        <div class="col-sm-6 text-left">{{ pagination }}</div>
        <div class="col-sm-6 text-right">{{ results }}</div>
      </div>
      {% endif %}
      {% if not categories and not categorybundles %}
      <p>{{ text_empty }}</p>
      <div class="buttons">
        <div class="pull-right"><a href="{{ continue }}" class="btn btn-primary">{{ button_continue }}</a></div>
      </div>
      {% endif %}
      </div>
    {{ column_right }}</div>
</div>


          </div>

<script type="text/javascript"><!--
$(document).on('click','.bundle-cart',function() {
  bundle_id=$(this).attr('rel');
  $.ajax({
    url: 'index.php?route=extension/bundleproduct/addToCart',
    type: 'post',
    data :$('.tmdcartbundle'+bundle_id).serialize(),
    dataType: 'json',
    beforeSend: function(json) {
        $('body').append('<span class="basel-spinner ajax-call"></span>');
      },
    complete: function() {
      $('.addloading'+bundle_id).button('reset');
    },
   success: function(json) {
        $('.alert, .text-danger').remove();
        $('.table-cell').removeClass('has-error');

        if (json.error) {
          $('.basel-spinner.ajax-call').remove();
          if (json.error.option) {
            for (i in json.error.option) {
              var element = $('#input-option' + i.replace('_', '-'));

              if (element.parent().hasClass('input-group')) {
                element.parent().after('<div class="text-danger">' + json.error.option[i] + '</div>');
              } else {
                element.after('<div class="text-danger">' + json.error.option[i] + '</div>');
              }
            }
          }

          if (json.error.recurring) {
            $('select[name=\'recurring_id\']').after('<div class="text-danger">' + json['error']['recurring'] + '</div>');
          }

          // Highlight any found errors
          $('.text-danger').parent().addClass('has-error');
        }

        if (json.success_redirect) {

          location = json.success_redirect;

        } else if (json.success) {

          $('.table-cell').removeClass('has-error');
          $('.alert, .popup-note, .basel-spinner.ajax-call, .text-danger').remove();

          html = '<div class="popup-note">';
          html += '<div class="inner">';
          html += '<a class="popup-note-close" onclick="$(this).parent().parent().remove()">&times;</a>';
          html += '<div class="table">';
          html += '<div class="table-cell v-top">' + json.success + '</div>';
          html += '</div>';
          html += '</div>';
          html += '</div>';
          $('body').append(html);
          setTimeout(function() {$('.popup-note').hide();}, 8100);
          // Need to set timeout otherwise it wont update the total
          setTimeout(function () {
            $('.cart-total-items').html( json.total_items );
            $('.cart-total-amount').html( json.total_amount );
          }, 100);

          $('#cart-content').load('index.php?route=common/cart/info #cart-content > *');
        }
      },
      error: function(xhr, ajaxOptions, thrownError) {
        alert(thrownError + "\r\n" + xhr.statusText + "\r\n" + xhr.responseText);
      }
    });
  });
</script>

<style>
.product-layout:first-child .plusign{
  display:none;
}
.plusign .fa{
  font-size:14px;
}
.plusign{
  float:left;
  display: inline-block;
  margin:50% 6% 0 -16%;
}
.total h5{
    font-weight: bold;
    font-size: 14px;
}
.plusign1{
  float:left;
  display: inline-block;
  margin:50% 6% 0 -11%;
}
@media (min-width: 1200px) {
    .bundle-bundleproduct .col-md-2{
        width:20% !important;
        clear: none !important;
    }
    .bundle-bundleproduct .product-layout:nth-child(5n+1) .plusign{
        display:none;
    }
}
@media (min-width: 992px) and (max-width: 1199px) {
    .bundle-bundleproduct .col-md-2{
        width:25% !important;
        clear: none !important;
    }
    .bundle-bundleproduct .product-layout:nth-child(4n+1) .plusign{
        display:none;
    }
}
@media (min-width: 768px) and (max-width: 991px) {
    .bundle-bundleproduct .col-md-2{
        width:32% !important;
        clear: none !important;
    }
    .bundle-bundleproduct .product-layout:nth-child(3n+1) .plusign{
        display:none;
    }
}
  @media (max-width: 768px) {
        .plusign,.plusign1{display: none;}


  #column-left .inner > * {display: block;}
}

</style>
{{ content_bottom }}
{{ footer }} 
