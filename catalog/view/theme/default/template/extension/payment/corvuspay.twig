<form id="corvuspay-form" action="{{ action }}" method="post">
  {% for name, value in parameters %}
    <input type="hidden" name="{{ name }}" value="{{ value }}" />
  {% endfor %}

  <div class="buttons pull-right">
    {% if use_confirm %}
    <input type="button" value="{{ button_confirm }}" id="button-corvuspay-confirm" data-loading-text="{{ text_loading }}" class="btn btn-primary btn-blue" />
    {% else %}
    <input type="submit" value="{{ button_confirm }}" class="btn btn-primary btn-blue" />
    {% endif %}
  </div>
</form>

{% if use_confirm %}
<script type="text/javascript"><!--
$('#button-corvuspay-confirm').on('click', function() {
  var button = $(this);

  $.ajax({
    url: '{{ confirm_url }}',
    type: 'post',
    dataType: 'json',
    beforeSend: function() {
      button.button('loading');
    },
    complete: function() {
      button.button('reset');
    },
    success: function(json) {
      if (json['error']) {
        alert(json['error']);
      }

      if (json['success']) {
        document.getElementById('corvuspay-form').submit();
      }
    },
    error: function(xhr, ajaxOptions, thrownError) {
      console.log(thrownError + "\r\n" + xhr.statusText + "\r\n" + xhr.responseText);
      alert(xhr.statusText);
    }
  });
});
//--></script>
{% endif %}
